@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Client.Components.Crud

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">

                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@_model.IdWlasnosci.ToString()"
                                      Label="IdWlasnosci"
                                      ReadOnly="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_idEncjiText"
                                  Label="IdEncji (GUID)"
                                  Required="true"
                                  RequiredError="IdEncji jest wymagane"
                                  ReadOnly="@_isReadOnly"
                                  Error="@(!string.IsNullOrWhiteSpace(_idEncjiError))"
                                  ErrorText="@_idEncjiError"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="long"
                                     Label="IdPodmiotu"
                                     Required="true"
                                     RequiredError="IdPodmiotu jest wymagane"
                                     Margin="Margin.Dense"
                                     ReadOnly="@_isReadOnly"
                                     @bind-Value="_model.IdPodmiotu" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Label="Udział procent"
                                     Required="true"
                                     RequiredError="Udział procent jest wymagany"
                                     Margin="Margin.Dense"
                                     ReadOnly="@_isReadOnly"
                                     @bind-Value="_model.UdzialProcent" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Od dnia"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@FormatDate(_odDnia)" />
                    }
                    else
                    {
                        <MudDatePicker Label="Od dnia"
                                       Date="@_odDnia"
                                       DateChanged="@OnOdDniaChanged"
                                       Margin="Margin.Dense"
                                       Required="true"
                                       RequiredError="Od dnia jest wymagane" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Do dnia (opcjonalnie)"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@FormatDate(_doDnia)" />
                    }
                    else
                    {
                        <MudDatePicker Label="Do dnia (opcjonalnie)"
                                       Date="@_doDnia"
                                       DateChanged="@OnDoDniaChanged"
                                       Margin="Margin.Dense" />
                    }
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="@Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public WlasnoscDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private MudForm? _form;

    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private WlasnoscDto _model = new();
    private string _idEncjiText = string.Empty;
    private string? _idEncjiError;

    private DateTime? _odDnia;
    private DateTime? _doDnia;

    protected override void OnInitialized()
    {
        _model = new WlasnoscDto
        {
            IdWlasnosci = Model.IdWlasnosci,
            IdEncji = Model.IdEncji,
            IdPodmiotu = Model.IdPodmiotu,
            UdzialProcent = Model.UdzialProcent,
            OdDnia = Model.OdDnia,
            DoDnia = Model.DoDnia
        };

        _idEncjiText = _model.IdEncji == Guid.Empty ? string.Empty : _model.IdEncji.ToString();

        _odDnia = new DateTime(_model.OdDnia.Year, _model.OdDnia.Month, _model.OdDnia.Day);
        _doDnia = _model.DoDnia is null
            ? null
            : new DateTime(_model.DoDnia.Value.Year, _model.DoDnia.Value.Month, _model.DoDnia.Value.Day);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit()
        => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private void OnOdDniaChanged(DateTime? dt)
    {
        if (_isReadOnly) return;

        _odDnia = dt;
        if (dt is not null)
            _model.OdDnia = DateOnly.FromDateTime(dt.Value);
    }

    private void OnDoDniaChanged(DateTime? dt)
    {
        if (_isReadOnly) return;

        _doDnia = dt;
        _model.DoDnia = dt is null ? null : DateOnly.FromDateTime(dt.Value);
    }

    private async Task SaveAsync()
    {
        if (_isReadOnly) return;
        if (_form is null) return;

        _idEncjiError = null;

        await _form.Validate();
        if (!_form.IsValid) return;

        if (!Guid.TryParse(_idEncjiText?.Trim(), out var guid))
        {
            _idEncjiError = "Niepoprawny GUID w IdEncji.";
            return;
        }

        _model.IdEncji = guid;
        MudDialog.Close(DialogResult.Ok(_model));
    }
}
