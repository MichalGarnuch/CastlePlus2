@page "/podmioty/podmioty"
@attribute [Authorize(Roles = RoleCodes.AdminOrEmployee)]

@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Client.Services.Podmioty
@inject IPodmiotyService PodmiotyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Podmioty</MudText>

<MudPaper Class="pa-4">
    <MudTable T="PodmiotDto"
              ServerData="LoadServerData"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Loading="_loading"
              @ref="_table">

        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista Podmiotów</MudText>
            <MudSpacer />

            <MudTextField Value="_search"
                          ValueChanged="@_searchChangedCallback"
                          Placeholder="Szukaj..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh SortLabel="IdPodmiotu">Id</MudTh>
            <MudTh SortLabel="Nazwa">Nazwa</MudTh>
            <MudTh SortLabel="TypPodmiotu">Typ</MudTh>
            <MudTh SortLabel="NIP">NIP</MudTh>
            <MudTh SortLabel="REGON">REGON</MudTh>
            <MudTh SortLabel="PESEL">PESEL</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.IdPodmiotu</MudTd>
            <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
            <MudTd DataLabel="Typ">@context.TypPodmiotu</MudTd>
            <MudTd DataLabel="NIP">@context.NIP</MudTd>
            <MudTd DataLabel="REGON">@context.REGON</MudTd>
            <MudTd DataLabel="PESEL">@context.PESEL</MudTd>

            <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private string _search = string.Empty;
    private bool _loading = false;
    private MudTable<PodmiotDto>? _table;

    private EventCallback<string> _searchChangedCallback;

    protected override void OnInitialized()
    {
        // Jawna konwersja method-group → EventCallback<string> (usuwa CS1503).
        _searchChangedCallback = EventCallback.Factory.Create<string>(this, OnSearchChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_table is null) return;
        await _table.ReloadServerData();
    }

    private async Task<TableData<PodmiotDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _loading = true;
        try
        {
            var result = await PodmiotyService.GetPagedAsync(
                state.Page + 1, // zostawiamy 1-based; jeśli API ma 0-based, usuń +1
                state.PageSize,
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending);

            return new TableData<PodmiotDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania podmiotów: {ex.Message}", Severity.Error);
            return new TableData<PodmiotDto> { Items = Array.Empty<PodmiotDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters
        {
            ["Model"] = new PodmiotDto(),
            ["IsEdit"] = false
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<PodmiotDialog>("Dodaj podmiot", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PodmiotDialog.PodmiotDialogResult dialogResult)
        {
            Snackbar.Add($"Dodano podmiot (Id={dialogResult.IdPodmiotu}).", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditAsync(PodmiotDto item)
    {
        var clone = new PodmiotDto
        {
            IdPodmiotu = item.IdPodmiotu,
            Nazwa = item.Nazwa,
            TypPodmiotu = item.TypPodmiotu,
            NIP = item.NIP,
            REGON = item.REGON,
            PESEL = item.PESEL
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<PodmiotDialog>("Edytuj podmiot", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PodmiotDialog.PodmiotDialogResult)
        {
            Snackbar.Add("Zapisano zmiany.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(PodmiotDto item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć podmiot Id={item.IdPodmiotu}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirm != true) return;

        try
        {
            var ok = await PodmiotyService.DeleteAsync(item.IdPodmiotu);
            if (!ok)
            {
                Snackbar.Add("Nie znaleziono rekordu do usunięcia (404).", Severity.Warning);
                return;
            }

            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}
