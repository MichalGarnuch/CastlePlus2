@page "/podmioty/kontakty"
@attribute [Authorize(Roles = RoleCodes.AdminOrManagerOrEmployee)]

@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Contracts.Requests.Podmioty
@using CastlePlus2.Client.Services.Podmioty
@inject IKontaktyService KontaktyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Kontakty</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudTextField Label="Podmiot"
                      Dense="true"
                      ReadOnly="true"
                      Value="@_selectedPodmiotLabel"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="OpenPodmiotLookupDialog" />

        <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="OpenPodmiotLookupDialog">
                Wybierz podmiot
            </MudButton>
        </AuthorizeView>

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Info"
                       AriaLabel="Odśwież"
                       Title="Odśwież"
                       OnClick="ReloadAsync" />
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista kontaktów</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!_selectedPodmiotId.HasValue)"
                       OnClick="CreateAsync">
                Dodaj
            </MudButton>

        </AuthorizeView>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>IdPodmiotu</MudTh>
            <MudTh>Rodzaj</MudTh>
            <MudTh>Wartość</MudTh>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">
                <MudTh></MudTh>
            </AuthorizeView>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.IdKontaktu</MudTd>
            <MudTd DataLabel="IdPodmiotu">@context.IdPodmiotu</MudTd>
            <MudTd DataLabel="Rodzaj">@context.Rodzaj</MudTd>
            <MudTd DataLabel="Wartość">@context.Wartosc</MudTd>

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee" Context="authContext">


                <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
                </MudTd>


            </AuthorizeView>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private List<KontaktDto> _items = new();
    private long? _selectedPodmiotId;
    private string _selectedPodmiotLabel = string.Empty;
    private string _search = string.Empty;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            if (!_selectedPodmiotId.HasValue)
            {
                _items = new List<KontaktDto>();
                await InvokeAsync(StateHasChanged);
                return;
            }

            var data = await KontaktyService.GetByPodmiotIdAsync(_selectedPodmiotId.Value);
            _items = (data ?? new List<KontaktDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania kontaktów: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(KontaktDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return item.IdKontaktu.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || item.IdPodmiotu.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || (item.Rodzaj?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Wartosc?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task CreateAsync()
    {
        if (!_selectedPodmiotId.HasValue)
        {
            Snackbar.Add("Wybierz podmiot przed dodaniem kontaktu.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Model"] = new KontaktDto { IdPodmiotu = _selectedPodmiotId.Value },
            ["IsEdit"] = false
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<KontaktDialog>("Dodaj kontakt", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is KontaktDto model)
        {
            try
            {
                var request = new CreateKontaktRequest
                {
                    IdPodmiotu = model.IdPodmiotu,
                    Rodzaj = model.Rodzaj,
                    Wartosc = model.Wartosc
                };

                var created = await KontaktyService.CreateAsync(request);
                Snackbar.Add($"Dodano kontakt (Id={created.IdKontaktu}).", Severity.Success);
                await ReloadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Błąd dodawania: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditAsync(KontaktDto item)
    {
        var clone = new KontaktDto
        {
            IdKontaktu = item.IdKontaktu,
            IdPodmiotu = item.IdPodmiotu,
            Rodzaj = item.Rodzaj,
            Wartosc = item.Wartosc
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<KontaktDialog>("Edytuj kontakt", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is KontaktDto model)
        {
            try
            {
                var request = new UpdateKontaktRequest
                {
                    IdPodmiotu = model.IdPodmiotu,
                    Rodzaj = model.Rodzaj,
                    Wartosc = model.Wartosc
                };

                var ok = await KontaktyService.UpdateAsync(model.IdKontaktu, request);
                if (!ok)
                {
                    Snackbar.Add("Nie znaleziono rekordu do edycji (404).", Severity.Warning);
                    return;
                }

                Snackbar.Add("Zapisano zmiany.", Severity.Success);
                await ReloadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ViewAsync(KontaktDto item)
    {
        var clone = new KontaktDto
        {
            IdKontaktu = item.IdKontaktu,
            IdPodmiotu = item.IdPodmiotu,
            Rodzaj = item.Rodzaj,
            Wartosc = item.Wartosc
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true,
            ["IsReadOnly"] = true
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<KontaktDialog>("Podgląd kontaktu", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DialogActionResult { Action: DialogAction.Edit })
        {
            await EditAsync(item);
        }
    }

    private async Task DeleteAsync(KontaktDto item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć kontakt Id={item.IdKontaktu}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirm != true)
            return;

        try
        {
            var ok = await KontaktyService.DeleteAsync(item.IdKontaktu);
            if (!ok)
            {
                Snackbar.Add("Nie znaleziono rekordu do usunięcia (404).", Severity.Warning);
                return;
            }

            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenPodmiotLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<PodmiotLookupDialog>("Wybierz podmiot", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not PodmiotLookupDto selected)
            return;

        _selectedPodmiotId = selected.IdPodmiotu;
        _selectedPodmiotLabel = selected.Label;
        await ReloadAsync();
    }
}