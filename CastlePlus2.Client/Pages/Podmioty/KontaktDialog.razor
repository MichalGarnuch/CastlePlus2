﻿@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Client.Pages.Podmioty
@using CastlePlus2.Client.Services.Podmioty
@inject IDialogService DialogService
@inject IPodmiotyService PodmiotyService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@Model.IdKontaktu.ToString()"
                                      Label="IdKontaktu"
                                      Disabled="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField Label="Podmiot"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Podmiot jest wymagany"
                                  Value="@_podmiotLabel" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenPodmiotLookupDialog">
                            Wybierz podmiot
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Rodzaj"
                                  Label="Rodzaj"
                                  Required="true"
                                  RequiredError="Rodzaj jest wymagany"
                                  ReadOnly="IsReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Wartosc"
                                  Label="Wartosc"
                                  Required="true"
                                  RequiredError="Wartosc jest wymagana"
                                  ReadOnly="IsReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public KontaktDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;
    private string _podmiotLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPodmiotLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        Model.Rodzaj = Model.Rodzaj.Trim();
        Model.Wartosc = Model.Wartosc.Trim();

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private async Task LoadPodmiotLabelAsync()
    {
        if (Model.IdPodmiotu <= 0)
        {
            _podmiotLabel = string.Empty;
            return;
        }

        var podmiot = await PodmiotyService.GetByIdAsync(Model.IdPodmiotu);
        if (podmiot is null)
        {
            _podmiotLabel = Model.IdPodmiotu.ToString();
            return;
        }

        var nip = string.IsNullOrWhiteSpace(podmiot.NIP) ? "-" : podmiot.NIP;
        _podmiotLabel = $"{podmiot.Nazwa} (NIP: {nip})";
    }

    private async Task OpenPodmiotLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<PodmiotLookupDialog>("Wybierz podmiot", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not PodmiotLookupDto selected)
            return;

        Model.IdPodmiotu = selected.IdPodmiotu;
        _podmiotLabel = selected.Label;
    }
}