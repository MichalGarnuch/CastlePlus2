﻿@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Podmioty

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@Model.IdKontaktu.ToString()"
                                      Label="IdKontaktu"
                                      Disabled="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Podmiot"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@GetPodmiotLabel(Model.IdPodmiotu)" />
                    }
                    else
                    {
                        <MudSelect T="long"
                                   Label="Podmiot"
                                   @bind-Value="Model.IdPodmiotu"
                                   Required="true"
                                   RequiredError="Podmiot jest wymagany"
                                   Margin="Margin.Dense">
                            @foreach (var podmiot in Podmioty)
                            {
                                <MudSelectItem T="long" Value="@podmiot.IdPodmiotu">
                                    @($"Id={podmiot.IdPodmiotu} / {podmiot.Nazwa}")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Rodzaj"
                                  Label="Rodzaj"
                                  Required="true"
                                  RequiredError="Rodzaj jest wymagany"
                                  ReadOnly="IsReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Wartosc"
                                  Label="Wartosc"
                                  Required="true"
                                  RequiredError="Wartosc jest wymagana"
                                  ReadOnly="IsReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public KontaktDto Model { get; set; } = new();
    [Parameter] public List<PodmiotDto> Podmioty { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private string GetPodmiotLabel(long idPodmiotu)
    {
        var podmiot = Podmioty.FirstOrDefault(p => p.IdPodmiotu == idPodmiotu);
        return podmiot is null ? idPodmiotu.ToString() : $"Id={podmiot.IdPodmiotu} / {podmiot.Nazwa}";
    }

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        Model.Rodzaj = Model.Rodzaj.Trim();
        Model.Wartosc = Model.Wartosc.Trim();

        MudDialog.Close(DialogResult.Ok(Model));
    }
}