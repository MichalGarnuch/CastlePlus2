@using System
@using MudBlazor
@using CastlePlus2.Client.Services.Podmioty
@using CastlePlus2.Contracts.DTOs.Podmioty
@inject IPodmiotyService PodmiotyService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Wybierz podmiot</MudText>

            <MudTextField Value="_search"
                          ValueChanged="@(async (string v) => await OnSearchChanged(v))"
                          Label="Szukaj (nazwa / NIP / REGON / PESEL)"
                          Placeholder="np. NIP lub nazwa"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Margin="Margin.Dense" />
                      <MudTable @ref="_table"
                      ServerData="LoadServerData"
                      T="PodmiotLookupDto"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true"
                      Loading="_loading"
                      RowClassFunc="RowClassFunc"
                      RowsPerPage="@_rowsPerPage"
                      RowsPerPageOptions="new int[] { 20, 50, 100 }"
                      RowsPerPageChanged="@(async (int v) => await OnRowsPerPageChanged(v))"
                      OnRowClick="@(EventCallback.Factory.Create<TableRowClickEventArgs<PodmiotLookupDto>>(this, HandleRowClick))">

                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>NIP</MudTh>
                    <MudTh>Typ</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Id">@context.IdPodmiotu</MudTd>
                    <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
                    <MudTd DataLabel="NIP">@context.NIP</MudTd>
                    <MudTd DataLabel="Typ">@context.TypPodmiotu</MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Class="pa-4">Brak wyników.</MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

            <MudText Typo="Typo.caption">Wyników: @_totalItems</MudText>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_selected is null)"
                   OnClick="@Choose">
            Wybierz
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudTable<PodmiotLookupDto>? _table;
    private bool _loading;
    private int _rowsPerPage = 50;
    private int _totalItems;
    private string _search = string.Empty;

    private PodmiotLookupDto? _selected;
    private CancellationTokenSource? _searchCts;

    private async Task OnRowsPerPageChanged(int value)
    {
        _rowsPerPage = value;
        _selected = null;
        await ReloadAsync();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(250, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _selected = null;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_table is null)
        {
            return;
        }

        await _table.ReloadServerData();
    }

    private async Task<TableData<PodmiotLookupDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            var q = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
            var result = await PodmiotyService.SearchLookupPagedAsync(q, state.Page + 1, state.PageSize);
            _totalItems = result.TotalCount;
            return new TableData<PodmiotLookupDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania podmiotów (lookup): {ex.Message}", Severity.Error);
            return new TableData<PodmiotLookupDto>
            {
                Items = Array.Empty<PodmiotLookupDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleRowClick(TableRowClickEventArgs<PodmiotLookupDto> args)
    {
        _selected = args.Item;
    }

    private string RowClassFunc(PodmiotLookupDto item, int rowNumber)
    {
        if (_selected is null) return string.Empty;
        return item.IdPodmiotu == _selected.IdPodmiotu ? "mud-theme-primary" : string.Empty;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Choose()
    {
        if (_selected is null)
            return;

        MudDialog.Close(DialogResult.Ok(_selected));
    }
}