@page "/utrzymanie/powiazania-zlecenia"

@using MudBlazor
@using CastlePlus2.Client.Services.Utrzymanie
@using CastlePlus2.Contracts.DTOs.Utrzymanie
@using CastlePlus2.Contracts.Requests.Utrzymanie

@inject IPowiazaniaZleceniaService Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Powiązania zleceń</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista powiązań zleceń</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj (Id, zlecenie, encja)..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>IdZlecenia</MudTh>
            <MudTh>IdEncji</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.IdPowiazania</MudTd>
            <MudTd DataLabel="IdZlecenia">@context.IdZlecenia</MudTd>
            <MudTd DataLabel="IdEncji">@context.IdEncji</MudTd>
            <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private List<PowiazanieZleceniaDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var data = await Service.GetAllAsync();
            _items = (data ?? new List<PowiazanieZleceniaDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(PowiazanieZleceniaDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return item.IdPowiazania.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || item.IdZlecenia.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || item.IdEncji.ToString().Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = true
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PowiazanieZleceniaDialog>("Dodaj powiązanie", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled) return;

        var dto = (PowiazanieZleceniaDto)result.Data!;
        try
        {
            await Service.CreateAsync(new CreatePowiazanieZleceniaRequest
            {
                IdZlecenia = dto.IdZlecenia,
                IdEncji = dto.IdEncji
            });

            Snackbar.Add("Dodano.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd dodawania: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(PowiazanieZleceniaDto item)
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = false,
            ["IdPowiazania"] = item.IdPowiazania,
            ["IdZlecenia"] = item.IdZlecenia,
            ["IdEncji"] = item.IdEncji
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PowiazanieZleceniaDialog>("Edytuj powiązanie", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled) return;

        var dto = (PowiazanieZleceniaDto)result.Data!;
        try
        {
            await Service.UpdateAsync(item.IdPowiazania, new UpdatePowiazanieZleceniaRequest
            {
                IdZlecenia = dto.IdZlecenia,
                IdEncji = dto.IdEncji
            });

            Snackbar.Add("Zapisano.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewAsync(PowiazanieZleceniaDto item)
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = false,
            ["IdPowiazania"] = item.IdPowiazania,
            ["IdZlecenia"] = item.IdZlecenia,
            ["IdEncji"] = item.IdEncji,
            ["IsReadOnly"] = true
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<PowiazanieZleceniaDialog>("Podgląd powiązania", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DialogActionResult { Action: DialogAction.Edit })
        {
            await EditAsync(item);
        }
    }


    private async Task DeleteAsync(PowiazanieZleceniaDto item)
    {
        var ok = await DialogService.ShowMessageBox(
            "Usuń",
            $"Usunąć powiązanie {item.IdPowiazania} (Zlecenie: {item.IdZlecenia})?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (ok != true) return;

        try
        {
            await Service.DeleteAsync(item.IdPowiazania);
            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}