@page "/utrzymanie/zlecenia-pracy"
@using MudBlazor
@using CastlePlus2.Client.Services.Utrzymanie
@using CastlePlus2.Contracts.DTOs.Utrzymanie
@using CastlePlus2.Contracts.Requests.Utrzymanie
@inject IZleceniaPracyService Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Zlecenia pracy</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista zleceń pracy</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj (Id, tytuł, status, encja)..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Encja gospodarza</MudTh>
            <MudTh>Tytuł</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Utworzono</MudTh>
            <MudTh>Zamknięto</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.IdZlecenia</MudTd>
            <MudTd DataLabel="Encja gospodarza">@context.IdEncjiGospodarza</MudTd>
            <MudTd DataLabel="Tytuł">@context.Tytul</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
            <MudTd DataLabel="Utworzono">@FormatDate(context.DataUtworzenia)</MudTd>
            <MudTd DataLabel="Zamknięto">@FormatDate(context.DataZamkniecia)</MudTd>
            <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private List<ZleceniePracyDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var data = await Service.GetAllAsync();
            _items = (data ?? new List<ZleceniePracyDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(ZleceniePracyDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return item.IdZlecenia.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || item.IdEncjiGospodarza.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || (item.Tytul?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Status?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private string FormatDate(DateTime? date)
        => date is null ? "—" : date.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private async Task CreateAsync()
    {
        var model = new ZleceniePracyDto
        {
            Status = "Nowe",
            Tytul = string.Empty
        };

        var parameters = new DialogParameters
        {
            ["Model"] = model,
            ["IsEdit"] = false
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<ZleceniePracyDialog>("Dodaj zlecenie pracy", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled) return;

        var dto = (ZleceniePracyDto)result.Data!;
        try
        {
            await Service.CreateAsync(new CreateZleceniePracyRequest
            {
                IdEncjiGospodarza = dto.IdEncjiGospodarza,
                Tytul = dto.Tytul,
                Opis = dto.Opis,
                Status = dto.Status,
                DataZamkniecia = dto.DataZamkniecia
            });

            Snackbar.Add("Dodano.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd dodawania: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(ZleceniePracyDto item)
    {
        var clone = new ZleceniePracyDto
        {
            IdZlecenia = item.IdZlecenia,
            IdEncjiGospodarza = item.IdEncjiGospodarza,
            Tytul = item.Tytul,
            Opis = item.Opis,
            Status = item.Status,
            DataUtworzenia = item.DataUtworzenia,
            DataZamkniecia = item.DataZamkniecia
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<ZleceniePracyDialog>("Edytuj zlecenie pracy", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled) return;

        var dto = (ZleceniePracyDto)result.Data!;
        try
        {
            var updated = await Service.UpdateAsync(item.IdZlecenia, new UpdateZleceniePracyRequest
            {
                IdEncjiGospodarza = dto.IdEncjiGospodarza,
                Tytul = dto.Tytul,
                Opis = dto.Opis,
                Status = dto.Status,
                DataZamkniecia = dto.DataZamkniecia
            });

            if (!updated)
            {
                Snackbar.Add("Nie znaleziono zlecenia do edycji.", Severity.Warning);
                return;
            }

            Snackbar.Add("Zapisano.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd edycji: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewAsync(ZleceniePracyDto item)
    {
        var clone = new ZleceniePracyDto
        {
            IdZlecenia = item.IdZlecenia,
            IdEncjiGospodarza = item.IdEncjiGospodarza,
            Tytul = item.Tytul,
            Status = item.Status,
            Opis = item.Opis,
            DataUtworzenia = item.DataUtworzenia,
            DataZamkniecia = item.DataZamkniecia
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true,
            ["IsReadOnly"] = true
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ZleceniePracyDialog>("Podgląd zlecenia pracy", parameters, options);
        await dialog.Result;
    }

    private async Task DeleteAsync(ZleceniePracyDto item)
    {
        var ok = await DialogService.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć zlecenie: {item.IdZlecenia} – {item.Tytul}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (ok != true) return;

        try
        {
            var deleted = await Service.DeleteAsync(item.IdZlecenia);
            if (!deleted)
            {
                Snackbar.Add("Nie znaleziono zlecenia do usunięcia.", Severity.Warning);
                return;
            }
            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}