@page "/utrzymanie/zgloszenia/nowe"
@attribute [Authorize(Roles = RoleCodes.AdminOrEmployeeOrUser)]

@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Utrzymanie
@using CastlePlus2.Contracts.Requests.Utrzymanie
@using CastlePlus2.Client.Services.Utrzymanie
@using CastlePlus2.Client.Pages.Rdzen
@using CastlePlus2.Contracts.DTOs.Rdzen
@inject IZgloszeniaService ZgloszeniaService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Zgłoszenie usterki</MudText>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudRadioGroup T="string"
                                   Row="true"
                                   SelectedOption="@_gospodarzTyp"
                                   SelectedOptionChanged="OnGospodarzTypChanged">
                        <MudRadio T="string" Option="@GospodarzTypLokal">Lokal</MudRadio>
                        <MudRadio T="string" Option="@GospodarzTypBudynek">Budynek</MudRadio>
                    </MudRadioGroup>
                </MudItem>

                <MudItem xs="12" sm="8">
                    <MudTextField Label="Przedmiot zgłoszenia"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Wybór jest wymagany"
                                  Margin="Margin.Dense"
                                  Value="@_gospodarzLabel" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="OpenGospodarzLookupDialog">
                        Wybierz
                    </MudButton>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Tytul"
                                  Label="Tytuł"
                                  Required="true"
                                  RequiredError="Tytuł jest wymagany"
                                  MaxLength="200"
                                  Counter="200"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Opis"
                                  Label="Opis"
                                  MaxLength="1000"
                                  Counter="1000"
                                  Lines="4"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>

        <MudDivider Class="my-4" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SubmitAsync"
                   Disabled="@(!_isFormValid || _saving)">
            Zgłoś usterkę
        </MudButton>
    }
</MudPaper>

@code {
    private const string GospodarzTypLokal = "Lokal";
    private const string GospodarzTypBudynek = "Budynek";

    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private bool _isFormValid;
    private string _gospodarzTyp = GospodarzTypLokal;
    private ZglosUsterkeContextDto _context = new();
    private ZglosUsterkeRequest _model = new();
    private string _gospodarzLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _context = await ZgloszeniaService.GetContextAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać danych kontekstu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnGospodarzTypChanged(string selected)
    {
        _gospodarzTyp = selected;
        _model.IdEncjiGospodarza = Guid.Empty;
        _gospodarzLabel = string.Empty;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();
        if (!_isFormValid)
        {
            return;
        }

        _saving = true;
        try
        {
            var result = await ZgloszeniaService.CreateAsync(_model);
            Snackbar.Add($"Zgłoszenie zostało zapisane (Id: {result.IdZlecenia}).", Severity.Success);
            _model = new ZglosUsterkeRequest();
            _gospodarzTyp = GospodarzTypLokal;
            _gospodarzLabel = string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się zapisać zgłoszenia: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenGospodarzLookupDialog()
    {
        var typ = _gospodarzTyp == GospodarzTypLokal ? "LOKAL" : "BUDYNEK";

        var parameters = new DialogParameters
        {
            ["InitialTypEncji"] = typ
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<EncjaLookupDialog>("Wybierz przedmiot zgłoszenia", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not EncjaLookupDto selected)
            return;

        _model.IdEncjiGospodarza = selected.IdEncji;
        _gospodarzLabel = selected.Label;
    }
}