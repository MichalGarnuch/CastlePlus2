@page "/"
@page "/dashboard"
@using CastlePlus2.Client.Services.Dashboard
@using CastlePlus2.Contracts.DTOs.Dashboard
@using MudBlazor
@inject IDashboardService DashboardService

<MudText Typo="Typo.h4" Class="fw-700 mb-6">Dashboard najmu</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 glass-panel">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Lokale razem</MudText>
                <MudText Typo="Typo.h4" Class="fw-700">@_dashboard.LokaleRazem</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 glass-panel">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning">Lokale zajęte</MudText>
                <MudText Typo="Typo.h4" Class="fw-700">@_dashboard.LokaleZajete</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 glass-panel">
                <MudText Typo="Typo.subtitle2" Color="Color.Success">Lokale wolne</MudText>
                <MudText Typo="Typo.h4" Class="fw-700">@_dashboard.LokaleWolne</MudText>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="fw-700 mt-8 mb-4">Wygasające umowy (30 dni)</MudText>

    <MudTable Items="_dashboard.WygasajaceUmowy" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Umowa</MudTh>
            <MudTh>Przedmiot najmu</MudTh>
            <MudTh>Najemca</MudTh>
            <MudTh>Wynajmujący</MudTh>
            <MudTh>Data zakończenia</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Umowa">
                @(!string.IsNullOrWhiteSpace(context.KodUmowy)
                            ? context.KodUmowy
                            : context.IdUmowy.ToString()[..8])
        </MudTd>

            <MudTd DataLabel="Przedmiot najmu">
                @(string.IsNullOrWhiteSpace(context.PrzedmiotNajmu) ? "-" : context.PrzedmiotNajmu)
            </MudTd>

            <MudTd DataLabel="Najemca">@context.Najemca</MudTd>
            <MudTd DataLabel="Wynajmujący">@context.Wynajmujacy</MudTd>

            <MudTd DataLabel="Data zakończenia">@context.DataZakonczenia.ToString("yyyy-MM-dd")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Brak umów do wyświetlenia.</MudText>
        </NoRecordsContent>
    </MudTable>

}

@code {
    private NajemDashboardDto _dashboard = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await DashboardService.GetNajemDashboardAsync();
        }
        catch (Exception)
        {
            _error = "Nie udało się wczytać danych dashboardu.";
        }
        finally
        {
            _loading = false;
        }
    }
}