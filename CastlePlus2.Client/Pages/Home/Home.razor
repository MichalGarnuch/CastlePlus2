@page "/"
@page "/home"
@layout CastlePlus2.Client.Shared.AuthLayout

@using CastlePlus2.Shared.Auth

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ILogger<Home> Logger

<MudCard Class="pa-4 glass-panel">
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="fw-700">Przekierowanie…</MudText>
        <MudProgressLinear Indeterminate="true" />
    </MudStack>
</MudCard>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Logger.LogInformation("Home redirect: not authenticated -> /auth/login");
            Nav.NavigateTo("/auth/login", replace: true);
            return;
        }

        // Role-based landing (jedno miejsce sterujące stroną startową)
        string targetUrl;

        if (user.IsInRole(RoleCodes.Admin) || user.IsInRole(RoleCodes.Employee) || user.IsInRole(RoleCodes.Manager))
        {
            targetUrl = "/dashboard/najem";
        }
        else if (user.IsInRole(RoleCodes.User))
        {
            // User ma dostęp do tej strony (Authorize: AdminOrEmployeeOrUser)
            targetUrl = "/utrzymanie/zgloszenia/nowe";
        }
        else
        {
            // Safety: zalogowany, ale brak ról w tokenie
            targetUrl = "/utrzymanie/zgloszenia/nowe";
        }

        Logger.LogInformation("Home redirect: authenticated={IsAuthenticated}, target={TargetUrl}", true, targetUrl);
        Nav.NavigateTo(targetUrl, replace: true);
    }
}