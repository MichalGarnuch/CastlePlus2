@page "/"
@page "/home"
@layout CastlePlus2.Client.Shared.AuthLayout

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<MudCard Class="pa-4 glass-panel">
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="fw-700">Przekierowanie…</MudText>
        <MudProgressLinear Indeterminate="true" />
    </MudStack>
</MudCard>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
        var targetUrl = isAuthenticated ? "/dashboard/najem" : "/auth/login";

        Nav.NavigateTo(targetUrl, replace: true);
    }
}