@page "/admin/uzytkownicy-role"
@attribute [Authorize(Roles = RoleCodes.Admin)]
@using System
@using CastlePlus2.Client.Services.Auth.Admin
@using CastlePlus2.Contracts.DTOs.Auth
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IAuthAdminService AuthAdminService
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Administracja: użytkownicy i role</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h6">Zarządzanie rolami</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="@(() => Nav.NavigateTo("/admin/create-user"))">
                Dodaj konto
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadAsync">
                Odśwież listę
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="RefreshSessionAsync">
                Odśwież sesję
            </MudButton>
        </MudStack>
    </MudStack>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        Zmiana ról nie odświeża tokena natychmiast. Użyj „Odśwież sesję”, aby pobrać nowy token JWT.
    </MudAlert>

    <MudTable Items="_users"
              Dense="true"
              Hover="true"
              Bordered="true"
              Loading="_loading">
        <HeaderContent>
            <MudTh>Login</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Aktywny</MudTh>
            <MudTh>Role</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Login">@context.Login</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Aktywny">
                @if (context.CzyAktywny)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Tak</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Nie</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Role">
                <MudSelect T="string"
                           Dense="true"
                           MultiSelection="true"
                           SelectedValues="GetSelectedRoles(context.IdUzytkownika)"
                           SelectedValuesChanged="values => OnRolesChanged(context.IdUzytkownika, values)">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem Value="@role.Kod">@role.Kod</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Akcje" Class="text-right">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsSaving(context.IdUzytkownika)"
                           OnClick="@(() => SaveRolesAsync(context))">
                    Zapisz
                </MudButton>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak użytkowników.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private readonly Dictionary<int, HashSet<string>> _selectedRoles = new();
    private readonly HashSet<int> _savingUsers = new();
    private List<AdminUserDto> _users = new();
    private List<RoleDto> _roles = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var roles = await AuthAdminService.GetRolesAsync();
            var users = await AuthAdminService.GetUsersAsync();

            _roles = roles.OrderBy(r => r.Kod).ToList();
            _users = users.OrderBy(u => u.Login).ToList();

            _selectedRoles.Clear();
            foreach (var user in _users)
            {
                _selectedRoles[user.IdUzytkownika] = new HashSet<string>(
                    user.RoleCodes ?? Array.Empty<string>(),
                    StringComparer.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyCollection<string> GetSelectedRoles(int userId)
    {
        if (_selectedRoles.TryGetValue(userId, out var roles))
        {
            return roles;
        }

        var created = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedRoles[userId] = created;
        return created;
    }

    private void OnRolesChanged(int userId, IEnumerable<string> values)
    {
        _selectedRoles[userId] = new HashSet<string>(values, StringComparer.OrdinalIgnoreCase);
    }

    private bool IsSaving(int userId) => _savingUsers.Contains(userId);

    private async Task SaveRolesAsync(AdminUserDto user)
    {
        if (!_selectedRoles.TryGetValue(user.IdUzytkownika, out var roles))
        {
            Snackbar.Add("Brak wybranych ról.", Severity.Warning);
            return;
        }

        _savingUsers.Add(user.IdUzytkownika);
        try
        {
            var roleCodes = roles.ToArray();
            await AuthAdminService.SetUserRolesAsync(user.IdUzytkownika, roleCodes);
            user.RoleCodes = roleCodes;
            Snackbar.Add("Zapisano role użytkownika.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu ról: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingUsers.Remove(user.IdUzytkownika);
        }
    }

    private async Task RefreshSessionAsync()
    {
        try
        {
            await AuthService.RefreshAsync("client");
            await AuthStateProvider.MarkUserAsAuthenticatedFromTokenAsync();
            Snackbar.Add("Sesja została odświeżona.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się odświeżyć sesji: {ex.Message}", Severity.Error);
        }
    }
}
