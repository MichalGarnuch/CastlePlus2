@page "/admin/uzytkownicy-role"
@attribute [Authorize(Roles = RoleCodes.Admin)]
@using System
@using CastlePlus2.Client.Services.Auth.Admin
@using CastlePlus2.Contracts.DTOs.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject IAuthAdminService AuthAdminService
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Administracja: użytkownicy i role</MudText>

<MudPaper Class="pa-4 users-role-page">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h6">Zarządzanie rolami</MudText>
        <MudStack Row="true" Spacing="2">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="GoCreateUser">
                Dodaj konto
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadClickAsync">
                Odśwież listę
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="RefreshSessionClickAsync">
                Odśwież sesję
            </MudButton>
        </MudStack>
    </MudStack>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        Zmiana ról nie odświeża tokena natychmiast. Użyj „Odśwież sesję”, aby pobrać nowy token JWT.
    </MudAlert>

    <div class="users-role-table-scroll">
        <MudTable Items="_users"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Loading="_loading"
                  Class="users-role-table">
            <HeaderContent>
                <MudTh>Login</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Aktywny</MudTh>
                <MudTh Style="min-width:320px;">Role</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Login">
                    <span class="truncate" title="@context.Login">@context.Login</span>
                </MudTd>

                <MudTd DataLabel="Email">
                    <span class="truncate" title="@context.Email">@context.Email</span>
                </MudTd>

                <MudTd DataLabel="Aktywny">
                    @if (context.CzyAktywny)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Tak</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Nie</MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Role">
                    <MudSelect T="string"
                               Dense="true"
                               MultiSelection="true"
                               Class="role-select"
                               Style="min-width:320px; max-width:520px;"
                               SelectedValues="@GetSelectedRolesSet(context.IdUzytkownika)"
                               SelectedValuesChanged="@(v => OnRolesChanged(context.IdUzytkownika, v))">
                        @foreach (var role in _roles)
                        {
                            <MudSelectItem Value="@role.Kod">
                                <span class="role-option">@role.Kod</span>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>

                <MudTd DataLabel="Akcje" Class="text-right">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@IsSaving(context.IdUzytkownika)"
                               OnClick="@(args => SaveClickAsync(args, context))">
                        Zapisz
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">Brak użytkowników.</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>
</MudPaper>

@code {
    private readonly Dictionary<int, HashSet<string>> _selectedRoles = new();
    private readonly HashSet<int> _savingUsers = new();
    private List<AdminUserDto> _users = new();
    private List<RoleDto> _roles = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    // --- kliknięcia (sygnatury pasujące do EventCallback<MouseEventArgs>) ---

    private void GoCreateUser(MouseEventArgs _)
        => Nav.NavigateTo("/admin/create-user");

    private async Task ReloadClickAsync(MouseEventArgs _)
        => await ReloadAsync();

    private async Task RefreshSessionClickAsync(MouseEventArgs _)
        => await RefreshSessionAsync();

    private async Task SaveClickAsync(MouseEventArgs _, AdminUserDto user)
        => await SaveRolesAsync(user);

    // --- data load ---

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var roles = await AuthAdminService.GetRolesAsync();
            var users = await AuthAdminService.GetUsersAsync();

            _roles = roles.OrderBy(r => r.Kod).ToList();
            _users = users.OrderBy(u => u.Login).ToList();

            _selectedRoles.Clear();
            foreach (var user in _users)
            {
                _selectedRoles[user.IdUzytkownika] = new HashSet<string>(
                    user.RoleCodes ?? Array.Empty<string>(),
                    StringComparer.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private HashSet<string> GetSelectedRolesSet(int userId)
    {
        if (_selectedRoles.TryGetValue(userId, out var roles))
            return roles;

        var created = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedRoles[userId] = created;
        return created;
    }

    // UWAGA: IEnumerable<string> zamiast HashSet<string> (pasuje do MudSelect)
    private void OnRolesChanged(int userId, IEnumerable<string> values)
    {
        _selectedRoles[userId] = new HashSet<string>(values ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
    }

    private bool IsSaving(int userId) => _savingUsers.Contains(userId);

    private async Task SaveRolesAsync(AdminUserDto user)
    {
        if (!_selectedRoles.TryGetValue(user.IdUzytkownika, out var roles))
        {
            Snackbar.Add("Brak wybranych ról.", Severity.Warning);
            return;
        }

        _savingUsers.Add(user.IdUzytkownika);
        try
        {
            var roleCodes = roles.ToArray();
            await AuthAdminService.SetUserRolesAsync(user.IdUzytkownika, roleCodes);
            user.RoleCodes = roleCodes;
            Snackbar.Add("Zapisano role użytkownika.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu ról: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingUsers.Remove(user.IdUzytkownika);
        }
    }

    private async Task RefreshSessionAsync()
    {
        try
        {
            await AuthService.RefreshAsync("client");
            await AuthStateProvider.MarkUserAsAuthenticatedFromTokenAsync();
            Snackbar.Add("Sesja została odświeżona.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się odświeżyć sesji: {ex.Message}", Severity.Error);
        }
    }
}
