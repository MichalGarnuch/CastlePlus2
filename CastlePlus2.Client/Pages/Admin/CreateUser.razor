@page "/admin/create-user"
@attribute [Authorize(Roles = RoleCodes.Admin)]

@using CastlePlus2.Shared.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using CastlePlus2.Client.Services.Auth.Admin
@using CastlePlus2.Contracts.DTOs.Auth
@using MudBlazor

@inject IAuthAdminService AuthAdminService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudPaper Class="pa-4 glass-card" Elevation="0">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5" Class="fw-700">Dodaj konto</MudText>
        <MudText Typo="Typo.body2" Class="opacity-80">
            Konto zostanie utworzone przez administratora z hasłem startowym. Użytkownik może zalogować się od razu.
        </MudText>

        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_login"
                              Label="Login"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Login jest wymagany" />

                <MudTextField @bind-Value="_email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Email jest wymagany" />

                <MudTextField @bind-Value="_password"
                              Label="Hasło"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Hasło jest wymagane" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Potwierdź hasło"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Potwierdzenie hasła jest wymagane" />

                <MudSelect T="string"
                           Label="Role"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectedValues="@_rolesSelected"
                           SelectedValuesChanged="OnRolesSelectedChanged">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem Value="@role.Kod">@role.Kod</MudSelectItem>
                    }
                </MudSelect>

                @if (_isSubmitting)
                {
                    <MudProgressLinear Indeterminate="true" />
                }

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Inherit"
                               OnClick="@( (MouseEventArgs _) => GoBack() )">
                        Wróć
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="_isSubmitting"
                               OnClick="@(async (MouseEventArgs _) => await HandleSubmitAsync())">
                        Utwórz konto
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudForm>
    </MudStack>
</MudPaper>

@code {
    private MudForm? _form;
    private string _login = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    private HashSet<string> _rolesSelected = new(StringComparer.OrdinalIgnoreCase);
    private List<RoleDto> _roles = new();
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            var roles = await AuthAdminService.GetRolesAsync();
            _roles = roles.OrderBy(r => r.Kod).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać ról: {ex.Message}", Severity.Error);
        }
    }

    private Task OnRolesSelectedChanged(IEnumerable<string> values)
    {
        _rolesSelected = new HashSet<string>(values ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void GoBack()
    {
        Nav.NavigateTo("/admin/uzytkownicy-role");
    }

    private async Task HandleSubmitAsync()
    {
        if (_isSubmitting)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Uzupełnij wymagane pola.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 8)
        {
            Snackbar.Add("Hasło musi mieć co najmniej 8 znaków.", Severity.Warning);
            return;
        }

        if (!string.Equals(_password, _confirmPassword, StringComparison.Ordinal))
        {
            Snackbar.Add("Potwierdzenie hasła musi być zgodne z hasłem.", Severity.Warning);
            return;
        }

        if (_rolesSelected.Count == 0)
        {
            Snackbar.Add("Wybierz co najmniej jedną rolę.", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            await AuthAdminService.CreateUserAsync(_login, _email, _password, _confirmPassword, _rolesSelected.ToArray());
            Snackbar.Add("Konto zostało utworzone.", Severity.Success);
            Nav.NavigateTo("/admin/uzytkownicy-role");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się utworzyć konta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}