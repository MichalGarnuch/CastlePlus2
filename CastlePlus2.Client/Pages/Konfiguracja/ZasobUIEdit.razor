@page "/konfiguracja/zasoby-ui/new"
@page "/konfiguracja/zasoby-ui/{IdEncji:guid?}"
@page "/konfiguracja/aktualnosci/new"
@page "/konfiguracja/aktualnosci/{IdEncji:guid?}"
@attribute [Authorize(Roles = RoleCodes.Admin)]

@using System.Linq

@using CastlePlus2.Client.Services.Dokumenty
@using CastlePlus2.Client.Services.Common
@using CastlePlus2.Client.Services.Konfiguracja
@using CastlePlus2.Contracts.DTOs.Dokumenty
@using CastlePlus2.Contracts.DTOs.Konfiguracja
@using CastlePlus2.Contracts.Requests.Dokumenty
@using CastlePlus2.Contracts.Requests.Konfiguracja

@using MudBlazor

@inject IZasobyUIService Service
@inject IZasobyUITekstyService TekstyService
@inject IPowiazaniaDokumentuService PowiazaniaService
@inject IDokumentyService DokumentyService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Zasób UI</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Spacing="2">

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h5">@(_isNew ? "Nowy zasób UI" : "Edycja zasobu UI")</MudText>
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy || _saving">Zapisz</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Back" Disabled="_busy || _saving">Wróć</MudButton>
            </MudStack>
        </MudStack>

        <MudDivider />

        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.KodZasobu" Label="Kod zasobu" Required="true" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Typ" Label="Typ" Required="true" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Kategoria" Label="Kategoria" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12" md="6"><MudNumericField T="int" @bind-Value="_model.Sort" Label="Sort" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.WazneOdUtc" Label="Ważne od (UTC)" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.WazneDoUtc" Label="Ważne do (UTC)" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12"><MudCheckBox T="bool" @bind-Checked="_model.CzyAktywny" Label="Aktywny" Disabled="_busy || _saving" /></MudItem>
        </MudGrid>

        <MudDivider Class="my-2" />

        <MudText Typo="Typo.h6">Teksty (CMS)</MudText>
        <MudGrid>
            <MudItem xs="12" md="2"><MudTextField @bind-Value="_newTekst.Jezyk" Label="Język" /></MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_newTekst.Pole" Label="Pole">
                    <MudSelectItem Value="@("Title")">Title</MudSelectItem>
                    <MudSelectItem Value="@("Lead")">Lead</MudSelectItem>
                    <MudSelectItem Value="@("Body")">Body</MudSelectItem>
                    <MudSelectItem Value="@("Value")">Value</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_newTekst.Format" Label="Format">
                    <MudSelectItem Value="@("Plain")">Plain</MudSelectItem>
                    <MudSelectItem Value="@("Markdown")">Markdown</MudSelectItem>
                    <MudSelectItem Value="@("Html")">Html</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2"><MudNumericField T="int" @bind-Value="_newTekst.Sort" Label="Sort" /></MudItem>
            <MudItem xs="12" md="12">
                <MudTextField @bind-Value="_newTekst.Wartosc"
                              Label="Wartość"
                              Required="true"
                              Immediate="true"
                              Lines="3"
                              Error="@HasTekstError(nameof(ZasobUITekstFormModel.Wartosc))"
                              ErrorText="@GetTekstErrorText(nameof(ZasobUITekstFormModel.Wartosc))" />
            </MudItem>
        </MudGrid>
        <MudButton Variant="Variant.Outlined" OnClick="OpenAddTekstAsync" Disabled="_busy || _saving || IsNewTekstInvalid">Dodaj tekst</MudButton>

        <MudTable Items="_teksty" Dense="true" Hover="true">
            <HeaderContent><MudTh>Język</MudTh><MudTh>Pole</MudTh><MudTh>Wartość</MudTh><MudTh>Format</MudTh><MudTh>Sort</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.Jezyk</MudTd><MudTd>@context.Pole</MudTd><MudTd>@context.Wartosc</MudTd><MudTd>@context.Format</MudTd><MudTd>@context.Sort</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(async () => await DeleteTekstAsync(context))" Disabled="_busy || _saving" /></MudTd>
            </RowTemplate>
        </MudTable>

        <MudDivider Class="my-2" />

        <MudText Typo="Typo.h6">Dokumenty (powiązania)</MudText>
        <MudGrid>
            <MudItem xs="12" md="4"><MudNumericField T="long?" @bind-Value="_powiazanieDokumentId" Label="IdDokumentu" Disabled="_busy || _saving" /></MudItem>
            <MudItem xs="12" md="4"><MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="AddPowiazanieAsync" Disabled="_busy || _saving || !_powiazanieDokumentId.HasValue">Powiąż dokument</MudButton></MudItem>
            <MudItem xs="12" md="4"><MudButton Variant="Variant.Outlined" OnClick="LoadDokumentyAsync" Disabled="_busy || _saving || !IdEncji.HasValue">Załaduj dokumenty powiązane</MudButton></MudItem>
        </MudGrid>

        <MudTable Items="_powiazania" Dense="true" Hover="true">
            <HeaderContent><MudTh>IdDokumentu</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.IdDokumentu</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(async () => await DeletePowiazanieAsync(context.IdPowiazania))" Disabled="_busy || _saving" /></MudTd>
            </RowTemplate>
        </MudTable>

        @if (_dokumentyLoaded)
        {
            <MudTable Items="_dokumenty" Dense="true" Hover="true">
                <HeaderContent><MudTh>Id</MudTh><MudTh>Nazwa</MudTh><MudTh>Opis</MudTh><MudTh>Ścieżka</MudTh></HeaderContent>
                <RowTemplate><MudTd>@context.IdDokumentu</MudTd><MudTd>@context.Nazwa</MudTd><MudTd>@context.Opis</MudTd><MudTd>@context.SciezkaPliku</MudTd></RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public Guid? IdEncji { get; set; }

    private bool _isNew => !IdEncji.HasValue;
    private bool _newsMode => Nav.Uri.Contains("/konfiguracja/aktualnosci", StringComparison.OrdinalIgnoreCase);

    private bool _busy;
    private bool _saving;
    private readonly ZasobUIFormModel _model = new();
    private readonly ZasobUITekstFormModel _newTekst = new();
    private readonly Dictionary<string, string> _newTekstFieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private List<ZasobUITekstDto> _teksty = new();
    private List<PowiazanieDokumentuDto> _powiazania = new();
    private long? _powiazanieDokumentId;
    private List<DokumentDto> _dokumenty = new();
    private bool _dokumentyLoaded;

    protected override async Task OnParametersSetAsync()
    {
        _busy = true;
        try
        {
            if (_isNew) InitNew();
            else await LoadAsync(IdEncji!.Value);
        }
        finally
        {
            _busy = false;
        }
    }

    private void InitNew()
    {
        _model.KodZasobu = _newsMode ? "NEWS_HOME_" : string.Empty;
        _model.Typ = _newsMode ? "NEWS" : string.Empty;
        _model.Kategoria = _newsMode ? "HOME" : null;
        _model.CzyAktywny = true;
        _model.Sort = 0;
        _teksty = new();
        _powiazania = new();
        _dokumenty = new();
        _dokumentyLoaded = false;
        _newTekst.Reset();
    }

    private async Task LoadAsync(Guid idEncji)
    {
        var dto = await Service.GetByIdAsync(idEncji);
        if (dto is null)
        {
            Snackbar.Add("Nie znaleziono zasobu UI.", Severity.Error);
            Back();
            return;
        }

        _model.KodZasobu = dto.KodZasobu;
        _model.Typ = dto.Typ;
        _model.Kategoria = dto.Kategoria;
        _model.CzyAktywny = dto.CzyAktywny;
        _model.Sort = dto.Sort;
        _model.WazneOdUtc = dto.WazneOdUtc;
        _model.WazneDoUtc = dto.WazneDoUtc;

        _teksty = await TekstyService.GetByEncjaAsync(idEncji);
        await LoadPowiazaniaAsync(idEncji);
        _dokumenty = new();
        _dokumentyLoaded = false;
    }

    private async Task LoadPowiazaniaAsync(Guid idEncji)
    {
        var all = await PowiazaniaService.GetAllAsync();
        _powiazania = all.Where(x => x.IdEncji == idEncji).ToList();
    }

    private async Task LoadDokumentyAsync()
    {
        if (!IdEncji.HasValue) return;
        _dokumenty = await DokumentyService.GetByEncjaIdAsync(IdEncji.Value);
        _dokumentyLoaded = true;
    }

    private async Task SaveAsync()
    {
        if (_busy || _saving) return;
        _busy = _saving = true;
        try
        {
            if (_isNew)
            {
                var newId = await Service.CreateAsync(new CreateZasobUIRequest
                {
                    KodZasobu = _model.KodZasobu,
                    Typ = _model.Typ,
                    Kategoria = _model.Kategoria,
                    CzyAktywny = _model.CzyAktywny,
                    Sort = _model.Sort,
                    WazneOdUtc = _model.WazneOdUtc,
                    WazneDoUtc = _model.WazneDoUtc
                });
                Snackbar.Add("Utworzono zasób UI.", Severity.Success);
                Nav.NavigateTo(_newsMode ? $"/konfiguracja/aktualnosci/{newId}" : $"/konfiguracja/zasoby-ui/{newId}");
                return;
            }

            await Service.UpdateAsync(IdEncji!.Value, new UpdateZasobUIRequest
            {
                KodZasobu = _model.KodZasobu,
                Typ = _model.Typ,
                Kategoria = _model.Kategoria,
                CzyAktywny = _model.CzyAktywny,
                Sort = _model.Sort,
                WazneOdUtc = _model.WazneOdUtc,
                WazneDoUtc = _model.WazneDoUtc
            });

            Snackbar.Add("Zapisano zmiany.", Severity.Success);
            await LoadAsync(IdEncji.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = _saving = false;
        }
    }

    private void Back() => Nav.NavigateTo(_newsMode ? "/konfiguracja/aktualnosci" : "/konfiguracja/zasoby-ui");

    private async Task OpenAddTekstAsync()
    {
        if (_busy || _saving) return;
        if (_isNew)
        {
            Snackbar.Add("Najpierw zapisz zasób UI, aby dodać teksty.", Severity.Warning);
            return;
        }

        _newTekstFieldErrors.Clear();
        if (string.IsNullOrWhiteSpace(_newTekst.Wartosc))
        {
            _newTekstFieldErrors[nameof(ZasobUITekstFormModel.Wartosc)] = "Pole 'Wartość' jest wymagane.";
            return;
        }

        _busy = true;
        try
        {
            await AddTekstAsync(_newTekst.Jezyk, _newTekst.Pole, _newTekst.Wartosc, _newTekst.Format, _newTekst.Sort);
            _newTekst.Reset();
            _newTekstFieldErrors.Clear();
        }
        catch (ApiValidationException ex)
        {
            ApplyTekstFieldErrors(ex.Errors);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd dodawania tekstu: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private bool IsNewTekstInvalid => string.IsNullOrWhiteSpace(_newTekst.Wartosc);

    private bool HasTekstError(string field)
        => _newTekstFieldErrors.ContainsKey(field);

    private string? GetTekstErrorText(string field)
        => _newTekstFieldErrors.TryGetValue(field, out var text) ? text : null;

    private void ApplyTekstFieldErrors(IReadOnlyDictionary<string, string[]> errors)
    {
        _newTekstFieldErrors.Clear();

        foreach (var (key, messages) in errors)
        {
            if (messages.Length == 0)
            {
                continue;
            }

            var normalizedKey = NormalizeTekstErrorField(key);
            _newTekstFieldErrors[normalizedKey] = string.Join(" ", messages);
        }
    }

    private static string NormalizeTekstErrorField(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return nameof(ZasobUITekstFormModel.Wartosc);
        }

        var normalized = key.Contains('.') ? key[(key.LastIndexOf('.') + 1)..] : key;
        return normalized;
    }

    private async Task AddTekstAsync(string jezyk, string pole, string wartosc, string format, int sort)
    {
        var newId = await TekstyService.CreateAsync(new CreateZasobUITekstRequest
        {
            IdEncji = IdEncji!.Value,
            Jezyk = jezyk,
            Pole = pole,
            Wartosc = wartosc,
            Format = format,
            Sort = sort
        });

        Snackbar.Add($"Dodano tekst (Id={newId}).", Severity.Success);
        _teksty = await TekstyService.GetByEncjaAsync(IdEncji!.Value);
    }

    private async Task DeleteTekstAsync(ZasobUITekstDto row)
    {
        if (_busy || _saving) return;
        _busy = true;
        try
        {
            await TekstyService.DeleteAsync(row.IdZasobuTekstu);
            Snackbar.Add("Usunięto tekst.", Severity.Success);
            if (IdEncji.HasValue) _teksty = await TekstyService.GetByEncjaAsync(IdEncji.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania tekstu: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task AddPowiazanieAsync()
    {
        if (_busy || _saving || _isNew || !IdEncji.HasValue || !_powiazanieDokumentId.HasValue) return;

        _busy = true;
        try
        {
            await PowiazaniaService.CreateAsync(new CreatePowiazanieDokumentuRequest { IdEncji = IdEncji.Value, IdDokumentu = _powiazanieDokumentId.Value });
            Snackbar.Add("Dodano powiązanie.", Severity.Success);
            await LoadPowiazaniaAsync(IdEncji.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd dodawania powiązania: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task DeletePowiazanieAsync(long idPowiazania)
    {
        if (_busy || _saving) return;

        _busy = true;
        try
        {
            await PowiazaniaService.DeleteAsync(idPowiazania);
            Snackbar.Add("Usunięto powiązanie.", Severity.Success);
            if (IdEncji.HasValue) await LoadPowiazaniaAsync(IdEncji.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania powiązania: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private sealed class ZasobUIFormModel
    {
        public string KodZasobu { get; set; } = string.Empty;
        public string Typ { get; set; } = string.Empty;
        public string? Kategoria { get; set; }
        public bool CzyAktywny { get; set; } = true;
        public int Sort { get; set; }
        public DateTime? WazneOdUtc { get; set; }
        public DateTime? WazneDoUtc { get; set; }
    }

    private sealed class ZasobUITekstFormModel
    {
        public string Jezyk { get; set; } = "pl-PL";
        public string Pole { get; set; } = "Title";
        public string Wartosc { get; set; } = string.Empty;
        public string Format { get; set; } = "Plain";
        public int Sort { get; set; }

        public void Reset()
        {
            Jezyk = "pl-PL";
            Pole = "Title";
            Wartosc = string.Empty;
            Format = "Plain";
            Sort = 0;
        }
    }
}

