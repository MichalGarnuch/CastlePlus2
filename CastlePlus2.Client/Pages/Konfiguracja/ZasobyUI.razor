@page "/konfiguracja/zasoby-ui"
@attribute [Authorize(Roles = RoleCodes.Admin)]

@using System
@using System.Linq
@using CastlePlus2.Client.Services.Konfiguracja
@using CastlePlus2.Contracts.DTOs.Konfiguracja
@using MudBlazor

@inject IZasobyUIService Service
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Zasoby UI</PageTitle>

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Zasoby UI</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Loading="_loading"
              @bind-SelectedItem="_selectedItem"
              RowClick="OnRowClick">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista zasobów</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="Create">
                Dodaj
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Kod</MudTh>
            <MudTh>Typ</MudTh>
            <MudTh>Kategoria</MudTh>
            <MudTh>Aktywny</MudTh>
            <MudTh>Sort</MudTh>
            <MudTh>Ważne od</MudTh>
            <MudTh>Ważne do</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Kod">@context.KodZasobu</MudTd>
            <MudTd DataLabel="Typ">@context.Typ</MudTd>
            <MudTd DataLabel="Kategoria">@context.Kategoria</MudTd>
            <MudTd DataLabel="Aktywny">@(context.CzyAktywny ? "Tak" : "Nie")</MudTd>
            <MudTd DataLabel="Sort">@context.Sort</MudTd>
            <MudTd DataLabel="Ważne od">@FormatDate(context.WazneOdUtc)</MudTd>
            <MudTd DataLabel="Ważne do">@FormatDate(context.WazneDoUtc)</MudTd>
            <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Title="Edytuj"
                               OnClick="@(() => Edit(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private bool _loading = true;
    private List<ZasobUIDto> _items = new();

    private ZasobUIDto? _selectedItem;
    private Guid? _selectedIdEncji;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;

        try
        {
            _items = await Service.GetAllAsync();

            // odtwórz zaznaczenie po odświeżeniu
            if (_selectedIdEncji.HasValue)
            {
                _selectedItem = _items.SingleOrDefault(x => x.IdEncji == _selectedIdEncji.Value);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Create()
    {
        Nav.NavigateTo("/konfiguracja/zasoby-ui/new");
    }

    private void Edit(ZasobUIDto item)
    {
        _selectedIdEncji = item.IdEncji;
        Nav.NavigateTo($"/konfiguracja/zasoby-ui/{item.IdEncji}");
    }

    private async Task ViewAsync(ZasobUIDto item)
    {
        var clone = new ZasobUIDto
        {
            IdEncji = item.IdEncji,
            KodZasobu = item.KodZasobu,
            Typ = item.Typ,
            Kategoria = item.Kategoria,
            CzyAktywny = item.CzyAktywny,
            Sort = item.Sort,
            WazneOdUtc = item.WazneOdUtc,
            WazneDoUtc = item.WazneDoUtc,
            UtworzonoUtc = item.UtworzonoUtc,
            ZmienionoUtc = item.ZmienionoUtc,
            Teksty = item.Teksty.ToList(),
            Dokumenty = item.Dokumenty.ToList()
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<ZasobUIViewDialog>("Podgląd zasobu UI", parameters, options);
        await dialog.Result;
    }

    private void OnRowClick(TableRowClickEventArgs<ZasobUIDto> args)
    {
        _selectedItem = args.Item;
        _selectedIdEncji = args.Item.IdEncji;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
}