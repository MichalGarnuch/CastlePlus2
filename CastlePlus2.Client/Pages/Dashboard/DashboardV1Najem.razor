@page "/dashboard/v1"
@attribute [Authorize(Roles = RoleCodes.AdminOrManagerOrEmployee)]

@using CastlePlus2.Client.Services.Dashboard
@using CastlePlus2.Contracts.DTOs.Dashboard
@using MudBlazor
@inject IDashboardService DashboardService

<MudText Typo="Typo.h4" Class="fw-700 mb-6">Dashboard V1 – najem</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 glass-panel">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Lokale razem</MudText>
                <MudText Typo="Typo.h4" Class="fw-700">@_dashboard.LokaleRazem</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 glass-panel">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning">Lokale zajęte</MudText>
                <MudText Typo="Typo.h4" Class="fw-700">@_dashboard.LokaleZajete</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 glass-panel">
                <MudText Typo="Typo.subtitle2" Color="Color.Success">Lokale wolne</MudText>
                <MudText Typo="Typo.h4" Class="fw-700">@_dashboard.LokaleWolne</MudText>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="fw-700 mt-8 mb-2">
        TOP 10 umów kończących się w 30 dni
    </MudText>

    <MudTable Items="_dashboard.UmowyKonczaSieWkrotce"
              Dense="true"
              Hover="true"
              RowsPerPage="10"
              Elevation="0">
        <HeaderContent>
            <MudTh>Umowa</MudTh>
            <MudTh>Najemca (ID)</MudTh>
            <MudTh>Wynajmujący (ID)</MudTh>
            <MudTh>Przedmiot najmu</MudTh>
            <MudTh>Data zakończenia</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Umowa">@context.IdUmowy.ToString()[..8]</MudTd>
            <MudTd DataLabel="Najemca">@context.IdNajemcy</MudTd>
            <MudTd DataLabel="Wynajmujący">@context.IdWynajmujacego</MudTd>
            <MudTd DataLabel="Przedmiot">@context.PrzedmiotNajmu</MudTd>
            <MudTd DataLabel="Data zakończenia">
                @(context.DataZakonczenia.HasValue
                    ? context.DataZakonczenia.Value.ToString("yyyy-MM-dd")
                    : "-")
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Brak umów do wyświetlenia.</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudText Typo="Typo.h6" Class="fw-700 mt-8 mb-2">
        TOP 10 zaległych faktur
    </MudText>

    <MudTable Items="_dashboard.ZalegleFaktury"
              Dense="true"
              Hover="true"
              RowsPerPage="10"
              Elevation="0">
        <HeaderContent>
            <MudTh>Faktura</MudTh>
            <MudTh>Data wystawienia</MudTh>
            <MudTh>Kwota brutto</MudTh>
            <MudTh>Kwota pozostała</MudTh>
            <MudTh>Waluta</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Faktura">@context.NumerFaktury</MudTd>
            <MudTd DataLabel="Data wystawienia">@context.DataWystawienia.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Kwota brutto">@context.KwotaBrutto.ToString("N2")</MudTd>
            <MudTd DataLabel="Kwota pozostała">@context.KwotaPozostala.ToString("N2")</MudTd>
            <MudTd DataLabel="Waluta">@context.KodWaluty</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Brak zaległych faktur.</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudButton Variant="Variant.Outlined" Class="mt-6" OnClick="Reload" Disabled="_loading">
        Odśwież
    </MudButton>
}

@code {
    private DashboardV1NajemDto _dashboard = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _error = null;

        try
        {
            _dashboard = await DashboardService.GetDashboardV1NajemAsync();
        }
        catch
        {
            _error = "Nie udało się wczytać danych dashboardu V1.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}