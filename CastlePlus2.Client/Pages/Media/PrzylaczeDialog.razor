@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Media
@using CastlePlus2.Contracts.DTOs.Rdzen
@using CastlePlus2.Client.Pages.Rdzen
@using CastlePlus2.Client.Services.Rdzen
@inject IDialogService DialogService
@inject IEncjeService EncjeService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Gospodarz (Nieruchomość)"
                                  Dense="true"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Gospodarz jest wymagany"
                                  Value="@_gospodarzLabel" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Rodzaj medium"
                                      Dense="true"
                                      ReadOnly="true"
                                      Value="@GetRodzajLabel(_model.KodRodzaju)" />
                    }
                    else
                    {
                        <MudSelect T="string"
                                   Label="Rodzaj medium"
                                   Dense="true"
                                   Required="true"
                                   @bind-Value="_model.KodRodzaju">
                            @foreach (var r in _rodzaje)
                            {
                                <MudSelectItem T="string" Value="@r.KodRodzaju">@($"{r.Nazwa} ({r.KodRodzaju})")</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenGospodarzLookupDialog">
                            Wybierz gospodarza
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField Label="Opis"
                                  Dense="true"
                                  Lines="3"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="_model.Opis" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PrzylaczeDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    [Parameter] public List<RodzajMediumDto> Rodzaje { get; set; } = new();

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;
    private PrzylaczeDto _model = new();

    private List<RodzajMediumDto> _rodzaje = new();
    private string _gospodarzLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _model = new PrzylaczeDto
        {
            IdPrzylacza = Model.IdPrzylacza,
            IdEncjiGospodarza = Model.IdEncjiGospodarza,
            KodRodzaju = Model.KodRodzaju,
            Opis = Model.Opis
        };

        _rodzaje = Rodzaje ?? new();
        await LoadGospodarzLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private string GetRodzajLabel(string? kodRodzaju)
    {
        var rodzaj = _rodzaje.FirstOrDefault(r => r.KodRodzaju == kodRodzaju);
        return rodzaj is null ? (kodRodzaju ?? string.Empty) : $"{rodzaj.Nazwa} ({rodzaj.KodRodzaju})";
    }

    private async Task SubmitAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null)
            return;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private async Task LoadGospodarzLabelAsync()
    {
        if (_model.IdEncjiGospodarza == Guid.Empty)
        {
            _gospodarzLabel = string.Empty;
            return;
        }

        var encja = await EncjeService.GetByIdAsync(_model.IdEncjiGospodarza);
        _gospodarzLabel = encja is null
            ? _model.IdEncjiGospodarza.ToString()
            : string.IsNullOrWhiteSpace(encja.KodEncji)
                ? encja.TypEncji
                : $"{encja.TypEncji} / {encja.KodEncji}";
    }

    private async Task OpenGospodarzLookupDialog()
    {
        var parameters = new DialogParameters
        {
            ["InitialTypEncji"] = "NIERUCHOMOSC"
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<EncjaLookupDialog>("Wybierz nieruchomość", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not EncjaLookupDto selected)
            return;

        _model.IdEncjiGospodarza = selected.IdEncji;
        _gospodarzLabel = selected.Label;
    }
}