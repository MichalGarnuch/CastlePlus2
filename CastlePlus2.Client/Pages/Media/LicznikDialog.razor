@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Media
@using CastlePlus2.Contracts.DTOs.Slowniki
@using CastlePlus2.Client.Components.Crud
@using CastlePlus2.Client.Services.Media
@inject IDialogService DialogService
@inject IPrzylaczaService PrzylaczaService
@inject ILicznikiService LicznikiService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Przyłącze"
                                  Dense="true"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Przyłącze jest wymagane"
                                  Value="@_przylaczeLabel" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Licznik nadrzędny (opcjonalnie)"
                                  Dense="true"
                                  ReadOnly="true"
                                  Value="@_licznikNadrzednyLabel" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenPrzylaczeLookupDialog">
                            Wybierz przyłącze
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenLicznikNadrzednyLookupDialog">
                            Wybierz licznik nadrzędny
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   OnClick="ClearLicznikNadrzedny"
                                   Class="ml-2">
                            Wyczyść
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField Label="NumerNV"
                                  Dense="true"
                                  Required="true"
                                  ReadOnly="@_isReadOnly"
                                  @bind-Value="_model.NumerNV" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="KodJednostki"
                                      Dense="true"
                                      ReadOnly="true"
                                      Value="@GetJednostkaLabel(_model.KodJednostki)" />
                    }
                    else
                    {
                        <MudSelect T="string"
                                   Label="KodJednostki"
                                   Dense="true"
                                   Required="true"
                                   @bind-Value="_model.KodJednostki">
                            @foreach (var j in _jednostki)
                            {
                                <MudSelectItem T="string" Value="@j.KodJednostki">
                                    @($"{j.Nazwa} ({j.KodJednostki})")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Współczynnik przeliczeniowy (decimal(12,6))"
                                     Dense="true"
                                     ReadOnly="@_isReadOnly"
                                     @bind-Value="_model.WspolczynnikPrzeliczeniowy" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                            @(_model.Aktywny ? "TAK" : "NIE")
                        </MudChip>
                    }
                    else
                    {
                        <MudSwitch T="bool"
                                   Label="Aktywny"
                                   Color="Color.Primary"
                                   @bind-Checked="_model.Aktywny" />
                    }
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="@Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SubmitAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public LicznikDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    [Parameter] public List<JednostkaMiaryDto> Jednostki { get; set; } = new();

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private LicznikDto _model = new();

    private List<JednostkaMiaryDto> _jednostki = new();
    private string _przylaczeLabel = string.Empty;
    private string _licznikNadrzednyLabel = "Brak";

    protected override async Task OnInitializedAsync()
    {
        _model = new LicznikDto
        {
            IdLicznika = Model.IdLicznika,
            IdPrzylacza = Model.IdPrzylacza,
            IdLicznikaNadrzednego = Model.IdLicznikaNadrzednego,
            NumerNV = Model.NumerNV,
            KodJednostki = Model.KodJednostki,
            WspolczynnikPrzeliczeniowy = Model.WspolczynnikPrzeliczeniowy,
            Aktywny = Model.Aktywny
        };

        _jednostki = Jednostki ?? new();
        await LoadLabelsAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit()
        => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));


    private string GetJednostkaLabel(string? kodJednostki)
    {
        var jednostka = _jednostki.FirstOrDefault(j => j.KodJednostki == kodJednostki);
        return jednostka is null ? (kodJednostki ?? string.Empty) : $"{jednostka.Nazwa} ({jednostka.KodJednostki})";
    }

    private async Task SubmitAsync()
    {
        if (_isReadOnly) return;
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private async Task LoadLabelsAsync()
    {
        if (_model.IdPrzylacza > 0)
        {
            var przylacze = await PrzylaczaService.GetByIdAsync(_model.IdPrzylacza);
            _przylaczeLabel = przylacze is null
                ? _model.IdPrzylacza.ToString()
                : $"Id={przylacze.IdPrzylacza} / Rodzaj={przylacze.KodRodzaju}";
        }
        else
        {
            _przylaczeLabel = string.Empty;
        }

        if (_model.IdLicznikaNadrzednego.HasValue)
        {
            var licznik = await LicznikiService.GetByIdAsync(_model.IdLicznikaNadrzednego.Value);
            _licznikNadrzednyLabel = licznik is null
                ? _model.IdLicznikaNadrzednego.Value.ToString()
                : $"Id={licznik.IdLicznika} / {licznik.NumerNV}";
        }
        else
        {
            _licznikNadrzednyLabel = "Brak";
        }
    }

    private async Task OpenPrzylaczeLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<PrzylaczeLookupDialog>("Wybierz przyłącze", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not PrzylaczeLookupDto selected)
            return;

        _model.IdPrzylacza = selected.IdPrzylacza;
        _przylaczeLabel = selected.Label;
    }

    private async Task OpenLicznikNadrzednyLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<LicznikLookupDialog>("Wybierz licznik nadrzędny", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not LicznikLookupDto selected)
            return;

        if (selected.IdLicznika == _model.IdLicznika)
        {
            return;
        }

        _model.IdLicznikaNadrzednego = selected.IdLicznika;
        _licznikNadrzednyLabel = selected.Label;
    }

    private void ClearLicznikNadrzedny()
    {
        _model.IdLicznikaNadrzednego = null;
        _licznikNadrzednyLabel = "Brak";
    }
}
