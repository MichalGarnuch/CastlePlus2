@using System.Linq
@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Media
@using CastlePlus2.Client.Components.Crud

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">

                <MudItem xs="12">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Licznik"
                                      ReadOnly="true"
                                      Margin="Margin.Dense"
                                      Value="@GetLicznikLabel(_model.IdLicznika)" />
                    }
                    else
                    {
                        <MudSelect T="long"
                                   Label="Licznik"
                                   Value="@_model.IdLicznika"
                                   ValueChanged="@OnLicznikChanged"
                                   Required="true"
                                   RequiredError="Licznik jest wymagany"
                                   Margin="Margin.Dense">
                            @foreach (var l in Liczniki)
                            {
                                <MudSelectItem T="long" Value="@l.IdLicznika">
                                    @($"{l.NumerNV} (Id={l.IdLicznika})")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Data odczytu"
                                      ReadOnly="true"
                                      Margin="Margin.Dense"
                                      Value="@FormatDate(_dataOdczytu)" />
                    }
                    else
                    {
                        <MudDatePicker Label="Data odczytu"
                                       Date="@_dataOdczytu"
                                       DateChanged="@OnDataChanged"
                                       Required="true"
                                       RequiredError="Data odczytu jest wymagana"
                                       Margin="Margin.Dense" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Wskazanie"
                                     Label="Wskazanie"
                                     Required="true"
                                     RequiredError="Wskazanie jest wymagane"
                                     ReadOnly="@_isReadOnly"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Zrodlo"
                                  Label="Źródło (max 20)"
                                  ReadOnly="@_isReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>

                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            IdOdczytu: @_model.IdOdczytu
                        </MudText>
                    </MudItem>
                }

            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Edit">
                Edytuj
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="@Cancel">
                Zamknij
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="@Cancel">
                Anuluj
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveAsync">
                Zapisz
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public OdczytDto Model { get; set; } = new();
    [Parameter] public List<LicznikDto> Liczniki { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private MudForm? _form;

    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private OdczytDto _model = new();
    private DateTime? _dataOdczytu;

    protected override void OnInitialized()
    {
        _model = new OdczytDto
        {
            IdOdczytu = Model.IdOdczytu,
            IdLicznika = Model.IdLicznika,
            DataOdczytu = Model.DataOdczytu,
            Wskazanie = Model.Wskazanie,
            Zrodlo = Model.Zrodlo
        };

        _dataOdczytu = (_model.DataOdczytu == default && !IsReadOnly && !IsEdit)
            ? DateTime.Today
            : _model.DataOdczytu;
    }

    private void OnLicznikChanged(long value)
    {
        if (_isReadOnly) return;
        _model.IdLicznika = value;
    }

    private void OnDataChanged(DateTime? value)
    {
        if (_isReadOnly) return;

        _dataOdczytu = value;
        _model.DataOdczytu = (value ?? DateTime.Today).Date;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit()
        => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private string GetLicznikLabel(long idLicznika)
    {
        var licznik = Liczniki.FirstOrDefault(l => l.IdLicznika == idLicznika);
        return licznik is null ? idLicznika.ToString() : $"{licznik.NumerNV} (Id={licznik.IdLicznika})";
    }

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private async Task SaveAsync()
    {
        if (_isReadOnly) return;
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        _model.DataOdczytu = (_dataOdczytu ?? DateTime.Today).Date;
        _model.Zrodlo = _model.Zrodlo?.Trim();

        MudDialog.Close(DialogResult.Ok(_model));
    }
}
