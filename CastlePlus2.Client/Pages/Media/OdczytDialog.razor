@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Media
@using CastlePlus2.Client.Services.Media
@inject IDialogService DialogService
@inject ILicznikiService LicznikiService
@using CastlePlus2.Client.Components.Crud

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">

                <MudItem xs="12">
                    <MudTextField Label="Licznik"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Licznik jest wymagany"
                                  Margin="Margin.Dense"
                                  Value="@_licznikLabel" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenLicznikLookupDialog">
                            Wybierz licznik
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Data odczytu"
                                      ReadOnly="true"
                                      Margin="Margin.Dense"
                                      Value="@FormatDate(_dataOdczytu)" />
                    }
                    else
                    {
                        <MudDatePicker Label="Data odczytu"
                                       Date="@_dataOdczytu"
                                       DateChanged="@OnDataChanged"
                                       Required="true"
                                       RequiredError="Data odczytu jest wymagana"
                                       Margin="Margin.Dense" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Wskazanie"
                                     Label="Wskazanie"
                                     Required="true"
                                     RequiredError="Wskazanie jest wymagane"
                                     ReadOnly="@_isReadOnly"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Zrodlo"
                                  Label="Źródło (max 20)"
                                  ReadOnly="@_isReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>

                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            IdOdczytu: @_model.IdOdczytu
                        </MudText>
                    </MudItem>
                }

            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Edit">
                Edytuj
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="@Cancel">
                Zamknij
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="@Cancel">
                Anuluj
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveAsync">
                Zapisz
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public OdczytDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private MudForm? _form;

    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private OdczytDto _model = new();
    private DateTime? _dataOdczytu;

    private string _licznikLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _model = new OdczytDto
        {
            IdOdczytu = Model.IdOdczytu,
            IdLicznika = Model.IdLicznika,
            DataOdczytu = Model.DataOdczytu,
            Wskazanie = Model.Wskazanie,
            Zrodlo = Model.Zrodlo
        };

        _dataOdczytu = (_model.DataOdczytu == default && !IsReadOnly && !IsEdit)
            ? DateTime.Today
            : _model.DataOdczytu;

        await LoadLicznikLabelAsync();
    }

    private async Task LoadLicznikLabelAsync()
    {
        if (_model.IdLicznika <= 0)
        {
            _licznikLabel = string.Empty;
            return;
        }

        var licznik = await LicznikiService.GetByIdAsync(_model.IdLicznika);
        _licznikLabel = licznik is null
            ? _model.IdLicznika.ToString()
            : $"{licznik.NumerNV} ({licznik.KodJednostki}) [Id={licznik.IdLicznika}]";
    }


    private void OnDataChanged(DateTime? value)
    {
        if (_isReadOnly) return;

        _dataOdczytu = value;
        _model.DataOdczytu = (value ?? DateTime.Today).Date;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit()
        => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));


    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private async Task SaveAsync()
    {
        if (_isReadOnly) return;
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        _model.DataOdczytu = (_dataOdczytu ?? DateTime.Today).Date;
        _model.Zrodlo = _model.Zrodlo?.Trim();

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private async Task OpenLicznikLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<LicznikLookupDialog>("Wybierz licznik", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not LicznikLookupDto selected)
            return;

        _model.IdLicznika = selected.IdLicznika;
        _licznikLabel = selected.Label;
    }
}
