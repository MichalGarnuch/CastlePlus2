@page "/media/rodzaje-mediow"
@attribute [Authorize(Roles = RoleCodes.AdminOrManagerOrEmployee)]

@using MudBlazor
@using CastlePlus2.Client.Services.Media
@using CastlePlus2.Contracts.DTOs.Media
@using CastlePlus2.Contracts.Requests.Media
@inject IRodzajeMediowService Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Rodzaje mediów</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista rodzajów mediów</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj (kod, nazwa)..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
                </MudButton>

            </AuthorizeView>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Kod</MudTh>
            <MudTh>Nazwa</MudTh>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">
                <MudTh></MudTh>
            </AuthorizeView>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Kod">@context.KodRodzaju</MudTd>
            <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee" Context="authContext">

                <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
                </MudTd>

            </AuthorizeView>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private List<RodzajMediumDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var data = await Service.GetAllAsync();
            _items = (data ?? new List<RodzajMediumDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(RodzajMediumDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return (item.KodRodzaju?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Nazwa?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = true
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RodzajMediumDialog>("Dodaj rodzaj medium", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled) return;

        var dto = (RodzajMediumDto)result.Data!;
        try
        {
            await Service.CreateAsync(new CreateRodzajMediumRequest
            {
                KodRodzaju = dto.KodRodzaju,
                Nazwa = dto.Nazwa
            });

            Snackbar.Add("Dodano.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd dodawania: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(RodzajMediumDto item)
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = false,
            ["KodRodzaju"] = item.KodRodzaju,
            ["Nazwa"] = item.Nazwa
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RodzajMediumDialog>("Edytuj rodzaj medium", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled) return;

        var dto = (RodzajMediumDto)result.Data!;
        try
        {
            await Service.UpdateAsync(item.KodRodzaju, new UpdateRodzajMediumRequest
            {
                Nazwa = dto.Nazwa
            });

            Snackbar.Add("Zapisano.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewAsync(RodzajMediumDto item)
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = false,
            ["KodRodzaju"] = item.KodRodzaju,
            ["Nazwa"] = item.Nazwa,
            ["IsReadOnly"] = true
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RodzajMediumDialog>("Podgląd rodzaju medium", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DialogActionResult { Action: DialogAction.Edit })
        {
            await EditAsync(item);
        }
    }

    private async Task DeleteAsync(RodzajMediumDto item)
    {
        var ok = await DialogService.ShowMessageBox(
            "Usuń",
            $"Usunąć {item.KodRodzaju} – {item.Nazwa}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (ok != true) return;

        try
        {
            await Service.DeleteAsync(item.KodRodzaju);
            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}