@using CastlePlus2.Contracts.DTOs.Media
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    @if (_isCreate)
                    {
                        <MudTextField @bind-Value="KodRodzaju"
                                      Label="Kod rodzaju"
                                      Required="true"
                                      MaxLength="20"
                                      ReadOnly="IsReadOnly"
                                      Immediate="true" />
                    }
                    else
                    {
                        <MudTextField Value="@KodRodzaju"
                                      Label="Kod rodzaju"
                                      Disabled="true" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Nazwa"
                                  Label="Nazwa"
                                  Required="true"
                                  MaxLength="100"
                                  ReadOnly="IsReadOnly"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public string KodRodzaju { get; set; } = string.Empty;
    [Parameter] public string Nazwa { get; set; } = string.Empty;
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm _form = default!;
    private bool _isCreate => IsCreate;
    private bool _isReadOnly => IsReadOnly;

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private async Task Save()
    {
        if (_isReadOnly)
            return;

        await _form.Validate();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(new RodzajMediumDto
        {
            KodRodzaju = KodRodzaju.Trim(),
            Nazwa = Nazwa.Trim()
        }));
    }
}