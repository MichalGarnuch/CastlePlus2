@page "/aktualnosci"

@using CastlePlus2.Client.Services.Konfiguracja
@using CastlePlus2.Contracts.DTOs.Konfiguracja
@using MudBlazor

@inject IZasobyUIService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Aktualności</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">Aktualności</MudText>

    @if (_loading)
    {
        <MudText Class="mt-2">Ładowanie...</MudText>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudText Class="mt-2">@_error</MudText>
    }
    else if (_items.Count == 0)
    {
        <MudText Class="mt-2">Brak aktualności.</MudText>
    }
    else
    {
        <MudGrid Class="mt-2">
            @foreach (var it in _items)
            {
                var title = PickField(it, "Title") ?? it.KodZasobu;
                var lead = PickField(it, "Lead");
                var body = PickField(it, "Body") ?? PickField(it, "Value");
                var attachmentsCount = it.Dokumenty?.Count ?? 0;

                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="pa-3 h-100 d-flex flex-column" Style="cursor:pointer;"
                             @onclick="() => OpenDetailsDialogAsync(it)">
                        <MudText Typo="Typo.h6">@title</MudText>
                        @if (!string.IsNullOrWhiteSpace(lead))
                        {
                            <MudText Class="mt-1"><b>@lead</b></MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(body))
                        {
                            <MudText Class="mt-2">@TrimForCard(body)</MudText>
                        }
                        <MudSpacer />
                        <MudChip T="string" Class="mt-2" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                            Załączniki: @attachmentsCount
                        </MudChip>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private string? _error;
    private List<ZasobUIPublicDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = (await Service.GetPublicAsync("NEWS", "HOME", "pl-PL", includeInactive: false))
                .OrderBy(x => x.Sort)
                .ThenByDescending(x => x.WazneOdUtc.HasValue)
                .ThenByDescending(x => x.WazneOdUtc)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = $"Błąd pobierania aktualności: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? PickField(ZasobUIPublicDto dto, string field)
    {
        var exact = dto.Teksty
            .Where(x => string.Equals(x.Pole, field, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.Sort)
            .Select(x => x.Wartosc)
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));

        if (!string.IsNullOrWhiteSpace(exact))
            return exact;

        if (string.Equals(field, "Body", StringComparison.OrdinalIgnoreCase))
        {
            return dto.Teksty
                .Where(x => string.Equals(x.Pole, "Value", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => x.Sort)
                .Select(x => x.Wartosc)
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        }

        return null;
    }

    private Task OpenDetailsDialogAsync(ZasobUIPublicDto item)
    {
        var parameters = new DialogParameters
        {
            [nameof(AktualnoscDetailsDialog.Model)] = item
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium
        };

        DialogService.Show<AktualnoscDetailsDialog>("Szczegóły aktualności", parameters, options);
        return Task.CompletedTask;
    }

    private static string TrimForCard(string value)
    {
        const int maxLength = 180;
        if (value.Length <= maxLength)
            return value;

        return $"{value[..maxLength]}...";
    }
}