@page "/aktualnosci"
@page "/public/aktualnosci"

@using System.Linq
@using System.Net.Http
@using CastlePlus2.Client.Services.Konfiguracja
@using CastlePlus2.Contracts.DTOs.Konfiguracja
@using MudBlazor

@inject IZasobyUIService Service
@inject ISnackbar Snackbar

<PageTitle>Aktualności</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">Aktualności</MudText>

    @if (_loading)
    {
        <MudText Class="mt-2">Ładowanie...</MudText>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudText Class="mt-2">@_error</MudText>
    }
    else if (_items.Count == 0)
    {
        <MudText Class="mt-2">Brak aktualności.</MudText>
    }
    else
    {
        <MudStack Class="mt-2" Spacing="2">
            @foreach (var it in _items.OrderByDescending(x => x.Sort))
            {
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.h6">@it.KodZasobu</MudText>

                    @if (it.Teksty is not null)
                    {
                        @foreach (var t in it.Teksty.OrderBy(x => x.Sort))
                        {
                            <MudText>@t.Wartosc</MudText>
                        }
                    }
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private string? _error;
    private List<ZasobUIPublicDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            // Typ=NEWS, Kategoria=HOME – pod ekran „Aktualności”
            _items = await Service.GetPublicAsync("NEWS", "HOME", "pl-PL");
        }
        catch (HttpRequestException ex)
        {
            _error = $"Błąd pobierania aktualności: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        catch (Exception ex)
        {
            _error = $"Nie udało się pobrać aktualności: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}