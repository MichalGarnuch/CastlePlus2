@page "/aktualnosci"
@page "/public/aktualnosci"

@using CastlePlus2.Client.Services.Konfiguracja
@using CastlePlus2.Contracts.DTOs.Konfiguracja
@using MudBlazor

@inject IZasobyUIService Service
@inject ISnackbar Snackbar

<PageTitle>Aktualności</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">Aktualności</MudText>

    @if (_loading)
    {
        <MudText Class="mt-2">Ładowanie...</MudText>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudText Class="mt-2">@_error</MudText>
    }
    else if (_items.Count == 0)
    {
        <MudText Class="mt-2">Brak aktualności.</MudText>
    }
    else
    {
        <MudStack Class="mt-2" Spacing="2">
            @foreach (var it in _items)
            {
                var title = PickField(it, "Title") ?? it.KodZasobu;
                var lead = PickField(it, "Lead");
                var body = PickField(it, "Body") ?? PickField(it, "Value");

                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.h6">@title</MudText>
                    @if (!string.IsNullOrWhiteSpace(lead))
                    {
                        <MudText Class="mt-1"><b>@lead</b></MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(body))
                    {
                        <MudText Class="mt-2">@body</MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private string? _error;
    private List<ZasobUIPublicDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = await Service.GetPublicAsync("NEWS", "HOME", "pl-PL");
        }
        catch (Exception ex)
        {
            _error = $"Błąd pobierania aktualności: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? PickField(ZasobUIPublicDto dto, string field)
    {
        var exact = dto.Teksty
            .Where(x => string.Equals(x.Pole, field, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.Sort)
            .Select(x => x.Wartosc)
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));

        if (!string.IsNullOrWhiteSpace(exact))
            return exact;

        if (string.Equals(field, "Body", StringComparison.OrdinalIgnoreCase))
        {
            return dto.Teksty
                .Where(x => string.Equals(x.Pole, "Value", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => x.Sort)
                .Select(x => x.Wartosc)
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        }

        return null;
    }
}