@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen
@using CastlePlus2.Client.Services.Rdzen
@inject IDialogService DialogService
@inject IEncjeService EncjeService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Budynek"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Budynek jest wymagany"
                                  Value="@_budynekLabel"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="OpenBudynekLookupDialog" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenBudynekLookupDialog">
                            Wybierz budynek
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Kod lokalu"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.KodLokalu" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Powierzchnia"
                                     Dense="true"
                                     Margin="Margin.Dense"
                                     ReadOnly="IsReadOnly"
                                     @bind-Value="Model.Powierzchnia" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Przeznaczenie"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.Przeznaczenie" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public LokalDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;
    private string _budynekLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBudynekLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private async Task Submit()
    {
        if (_isReadOnly)
            return;

        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        Model.KodLokalu = (Model.KodLokalu ?? string.Empty).Trim();
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private async Task LoadBudynekLabelAsync()
    {
        if (Model.IdBudynku == Guid.Empty)
        {
            _budynekLabel = string.Empty;
            return;
        }

        var encja = await EncjeService.GetByIdAsync(Model.IdBudynku);
        _budynekLabel = encja is null
            ? Model.IdBudynku.ToString()
            : string.IsNullOrWhiteSpace(encja.KodEncji)
                ? encja.TypEncji
                : $"{encja.TypEncji} / {encja.KodEncji}";
    }

    private async Task OpenBudynekLookupDialog()
    {
        if (_isReadOnly)
            return;

        var parameters = new DialogParameters
        {
            ["InitialTypEncji"] = "BUDYNEK"
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<EncjaLookupDialog>("Wybierz budynek", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not EncjaLookupDto selected)
            return;

        Model.IdBudynku = selected.IdEncji;
        _budynekLabel = selected.Label;
    }
}

