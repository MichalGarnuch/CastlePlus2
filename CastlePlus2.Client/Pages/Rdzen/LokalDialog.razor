@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Budynek"
                                      Dense="true"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@GetBudynekLabel(Model.IdBudynku)" />
                    }
                    else
                    {
                        <MudSelect T="Guid"
                                   Label="Budynek"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   @bind-Value="Model.IdBudynku">
                            @foreach (var b in (Budynki ?? new()))
                            {
                                var label = !string.IsNullOrWhiteSpace(b.KodBudynku) ? b.KodBudynku : b.Id.ToString();
                                <MudSelectItem T="Guid" Value="b.Id">@label</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Kod lokalu"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.KodLokalu" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Powierzchnia"
                                     Dense="true"
                                     Margin="Margin.Dense"
                                     ReadOnly="IsReadOnly"
                                     @bind-Value="Model.Powierzchnia" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Przeznaczenie"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.Przeznaczenie" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public LokalDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    [Parameter] public List<BudynekDto>? Budynki { get; set; }

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private string GetBudynekLabel(Guid idBudynku)
    {
        var budynek = (Budynki ?? new()).FirstOrDefault(b => b.Id == idBudynku);
        return budynek is null
            ? idBudynku.ToString()
            : (!string.IsNullOrWhiteSpace(budynek.KodBudynku) ? budynek.KodBudynku : budynek.Id.ToString());
    }

    private async Task Submit()
    {
        if (_isReadOnly)
            return;

        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        Model.KodLokalu = (Model.KodLokalu ?? string.Empty).Trim();
        MudDialog.Close(DialogResult.Ok(Model));
    }
}

