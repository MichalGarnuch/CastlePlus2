@using MudBlazor
@using CastlePlus2.Client.Services.Rdzen
@using CastlePlus2.Contracts.DTOs.Rdzen
@using Microsoft.AspNetCore.Components
@inject IEncjeService EncjeService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">

            <MudText Typo="Typo.h6">Wybierz encję</MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudSelect T="string"
                               Label="Typ encji"
                               Value="_typEncji"
                               ValueChanged="@(async (string v) => await OnTypEncjiChanged(v))"
                               Margin="Margin.Dense">
                        @foreach (var t in _typyEncji)
                        {
                            <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="8">
                    <MudTextField Value="_search"
                                  ValueChanged="@(async (string v) => await OnSearchChanged(v))"
                                  Label="Szukaj (kod / typ / id)"
                                  Placeholder="np. UN/2026/0001"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            <MudTable Items="_items"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true"
                      Loading="_loading"
                      RowClassFunc="RowClassFunc"
                      RowsPerPage="@_rowsPerPage"
                      RowsPerPageOptions="new int[] { 20, 50, 100, 200 }"
                      RowsPerPageChanged="@(async (int v) => await OnRowsPerPageChanged(v))"
                      OnRowClick="@(EventCallback.Factory.Create<TableRowClickEventArgs<EncjaLookupDto>>(this, HandleRowClick))">

                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Typ</MudTh>
                    <MudTh>Kod</MudTh>
                    <MudTh>Label</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Id">@context.IdEncji</MudTd>
                    <MudTd DataLabel="Typ">@context.TypEncji</MudTd>
                    <MudTd DataLabel="Kod">@context.KodEncji</MudTd>
                    <MudTd DataLabel="Label">@context.Label</MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Class="pa-4">Brak wyników.</MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

            <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption">Wyników: @_items.Count (limit: @_take)</MudText>
                <MudButton Variant="Variant.Outlined"
                           Disabled="@(_take >= 200)"
                           OnClick="@(async () => await LoadMore())">
                    Pokaż więcej
                </MudButton>
            </MudStack>

        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_selected is null)"
                   OnClick="@Choose">
            Wybierz
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string InitialTypEncji { get; set; } = "BUDYNEK";

    private readonly List<string> _typyEncji = new() { "BUDYNEK", "NIERUCHOMOSC", "LOKAL", "POMIESZCZENIE" };

    private List<EncjaLookupDto> _items = new();
    private bool _loading;

    private string _typEncji = "BUDYNEK";
    private string _search = string.Empty;

    private EncjaLookupDto? _selected;

    private int _rowsPerPage = 50;
    private int _take = 50;

    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        _typEncji = string.IsNullOrWhiteSpace(InitialTypEncji) ? "BUDYNEK" : InitialTypEncji;
        _take = Math.Min(200, _rowsPerPage);

        await ReloadAsync();
    }

    private async Task OnTypEncjiChanged(string value)
    {
        _typEncji = value;
        _selected = null;
        await ReloadAsync();
    }

    private async Task OnRowsPerPageChanged(int value)
    {
        _rowsPerPage = value;
        _take = Math.Min(200, value);
        _selected = null;
        await ReloadAsync();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;

        // debounce
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(250, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _selected = null;
        await ReloadAsync();
    }

    private async Task LoadMore()
    {
        _take = Math.Min(200, _take + 50);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var q = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
            _items = await EncjeService.SearchLookupAsync(_typEncji, q, _take);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania encji (lookup): {ex.Message}", Severity.Error);
            _items = new();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void HandleRowClick(TableRowClickEventArgs<EncjaLookupDto> args)
    {
        _selected = args.Item;
    }

    private string RowClassFunc(EncjaLookupDto item, int rowNumber)
    {
        if (_selected is null) return string.Empty;
        return item.IdEncji == _selected.IdEncji ? "mud-theme-primary" : string.Empty;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Choose()
    {
        if (_selected is null)
            return;

        MudDialog.Close(DialogResult.Ok(_selected));
    }
}
