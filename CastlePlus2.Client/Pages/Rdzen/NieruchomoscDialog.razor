@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@Model.Id.ToString()"
                                      Label="Id"
                                      Disabled="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Nazwa"
                                  Label="Nazwa"
                                  Required="true"
                                  RequiredError="Nazwa jest wymagana"
                                  ReadOnly="IsReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Adres główny (opcjonalnie)"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@GetAdresLabel(Model.IdAdresuGlownego)" />
                    }
                    else
                    {
                        <MudSelect T="long?"
                                   Label="Adres główny (opcjonalnie)"
                                   @bind-Value="Model.IdAdresuGlownego"
                                   Clearable="true"
                                   Margin="Margin.Dense">
                            <MudSelectItem Value="@((long?)null)">(brak)</MudSelectItem>

                            @foreach (var kv in Adresy)
                            {
                                <MudSelectItem Value="@((long?)kv.Key)">@kv.Value</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Właściciel (podmiot) (opcjonalnie)"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@GetPodmiotLabel(Model.IdPodmiotuWlasciciela)" />
                    }
                    else
                    {
                        <MudSelect T="long?"
                                   Label="Właściciel (podmiot) (opcjonalnie)"
                                   @bind-Value="Model.IdPodmiotuWlasciciela"
                                   Clearable="true"
                                   Margin="Margin.Dense">
                            <MudSelectItem Value="@((long?)null)">(brak)</MudSelectItem>

                            @foreach (var kv in Podmioty)
                            {
                                <MudSelectItem Value="@((long?)kv.Key)">@kv.Value</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public NieruchomoscDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    // Lookups przekazane z Nieruchomosci.razor
    [Parameter] public Dictionary<long, string> Adresy { get; set; } = new();
    [Parameter] public Dictionary<long, string> Podmioty { get; set; } = new();

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private string GetAdresLabel(long? idAdresu)
        => idAdresu is null ? "(brak)" : (Adresy.TryGetValue(idAdresu.Value, out var label) ? label : idAdresu.Value.ToString());

    private string GetPodmiotLabel(long? idPodmiotu)
        => idPodmiotu is null ? "(brak)" : (Podmioty.TryGetValue(idPodmiotu.Value, out var label) ? label : idPodmiotu.Value.ToString());

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        // Minimalne porządkowanie
        Model.Nazwa = (Model.Nazwa ?? string.Empty).Trim();

        MudDialog.Close(DialogResult.Ok(Model));
    }
}