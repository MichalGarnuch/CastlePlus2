@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Lokal"
                                      Dense="true"
                                      ReadOnly="true"
                                      Value="@GetLokalLabel(Model.IdEncjiNadrzednej)" />
                    }
                    else
                    {
                        <MudSelect T="Guid"
                                   Label="Lokal"
                                   Dense="true"
                                   Required="true"
                                   @bind-Value="Model.IdEncjiNadrzednej">
                            @foreach (var l in Lokale)
                            {
                                <MudSelectItem Value="@l.Id">
                                    @(!string.IsNullOrWhiteSpace(l.KodLokalu) ? l.KodLokalu : l.Id.ToString())
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Kod pomieszczenia"
                                  Dense="true"
                                  Required="true"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.KodPomieszczenia" />
                </MudItem>

                <MudItem xs="12">
                    <MudNumericField T="decimal?"
                                     Label="Powierzchnia"
                                     Dense="true"
                                     ReadOnly="IsReadOnly"
                                     @bind-Value="Model.Powierzchnia" />
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PomieszczenieDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<LokalDto> Lokale { get; set; } = new();
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private string GetLokalLabel(Guid idLokalu)
    {
        var lokal = Lokale.FirstOrDefault(l => l.Id == idLokalu);
        return lokal is null ? idLokalu.ToString() : (!string.IsNullOrWhiteSpace(lokal.KodLokalu) ? lokal.KodLokalu : lokal.Id.ToString());
    }

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(Model));
    }
}