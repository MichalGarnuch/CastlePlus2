@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen
@using CastlePlus2.Client.Services.Rdzen
@inject IDialogService DialogService
@inject IEncjeService EncjeService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Lokal"
                                  Dense="true"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Lokal jest wymagany"
                                  Value="@_lokalLabel"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="OpenLokalLookupDialog" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenLokalLookupDialog">
                            Wybierz lokal
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField Label="Kod pomieszczenia"
                                  Dense="true"
                                  Required="true"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.KodPomieszczenia" />
                </MudItem>

                <MudItem xs="12">
                    <MudNumericField T="decimal?"
                                     Label="Powierzchnia"
                                     Dense="true"
                                     ReadOnly="IsReadOnly"
                                     @bind-Value="Model.Powierzchnia" />
                </MudItem>
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PomieszczenieDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;
    private string _lokalLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLokalLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private async Task LoadLokalLabelAsync()
    {
        if (Model.IdEncjiNadrzednej == Guid.Empty)
        {
            _lokalLabel = string.Empty;
            return;
        }

        var encja = await EncjeService.GetByIdAsync(Model.IdEncjiNadrzednej);
        _lokalLabel = encja is null
            ? Model.IdEncjiNadrzednej.ToString()
            : string.IsNullOrWhiteSpace(encja.KodEncji)
                ? encja.TypEncji
                : $"{encja.TypEncji} / {encja.KodEncji}";
    }

    private async Task OpenLokalLookupDialog()
    {
        if (_isReadOnly)
            return;

        var parameters = new DialogParameters
        {
            ["InitialTypEncji"] = "LOKAL"
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<EncjaLookupDialog>("Wybierz lokal", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not EncjaLookupDto selected)
            return;

        Model.IdEncjiNadrzednej = selected.IdEncji;
        _lokalLabel = selected.Label;
    }
}