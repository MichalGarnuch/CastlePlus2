@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen
@using CastlePlus2.Client.Services.Rdzen
@inject IDialogService DialogService
@inject IAdresyService AdresyService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@Model.IdPrzypisaniaAdresu.ToString()"
                                      Label="IdPrzypisaniaAdresu"
                                      Disabled="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_idEncjiText"
                                  Label="IdEncji (GUID)"
                                  Required="true"
                                  RequiredError="IdEncji jest wymagane"
                                  Margin="Margin.Dense"
                                  ReadOnly="@(_isEdit || _isReadOnly)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Adres"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Adres jest wymagany"
                                  Value="@_adresLabel"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="OpenAdresLookupDialog" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenAdresLookupDialog">
                            Wybierz adres
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Od dnia"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@FormatDate(_odDnia)" />
                    }
                    else
                    {
                        <MudDatePicker Label="Od dnia"
                                       Date="@_odDnia"
                                       DateChanged="OnOdDniaChanged"
                                       Margin="Margin.Dense"
                                       Required="true" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    @if (_isReadOnly)
                    {
                        <MudTextField Label="Do dnia (opcjonalnie)"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Value="@FormatDate(_doDnia)" />
                    }
                    else
                    {
                        <MudDatePicker Label="Do dnia (opcjonalnie)"
                                       Date="@_doDnia"
                                       DateChanged="OnDoDniaChanged"
                                       Margin="Margin.Dense" />
                    }
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PrzypisanieAdresuDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private string _idEncjiText = string.Empty;
    private string _adresLabel = string.Empty;

    private DateTime? _odDnia;
    private DateTime? _doDnia;

    protected override async Task OnInitializedAsync()
    {
        _idEncjiText = Model.IdEncji == Guid.Empty ? string.Empty : Model.IdEncji.ToString();

        _odDnia = new DateTime(Model.OdDnia.Year, Model.OdDnia.Month, Model.OdDnia.Day);
        _doDnia = Model.DoDnia is null
            ? null
            : new DateTime(Model.DoDnia.Value.Year, Model.DoDnia.Value.Month, Model.DoDnia.Value.Day);

        await LoadAdresLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private void OnOdDniaChanged(DateTime? dt)
    {
        if (_isReadOnly)
            return;

        _odDnia = dt;
        if (dt is not null)
            Model.OdDnia = DateOnly.FromDateTime(dt.Value);
    }

    private void OnDoDniaChanged(DateTime? dt)
    {
        if (_isReadOnly)
            return;

        _doDnia = dt;
        Model.DoDnia = dt is null ? null : DateOnly.FromDateTime(dt.Value);
    }

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        if (!Guid.TryParse(_idEncjiText?.Trim(), out var guid))
        {
            // brak validacji GUID w MudTextField - robimy ręcznie
            return;
        }

        Model.IdEncji = guid;

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private async Task LoadAdresLabelAsync()
    {
        if (Model.IdAdresu <= 0)
        {
            _adresLabel = string.Empty;
            return;
        }

        var adres = await AdresyService.GetByIdAsync(Model.IdAdresu);
        _adresLabel = adres is null ? Model.IdAdresu.ToString() : adres.AdresPelny;
    }

    private async Task OpenAdresLookupDialog()
    {
        if (_isReadOnly)
        {
            return;
        }

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<AdresLookupDialog>("Wybierz adres", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not AdresLookupDto selected)
            return;

        Model.IdAdresu = selected.IdAdresu;
        _adresLabel = selected.Label;
    }
}
