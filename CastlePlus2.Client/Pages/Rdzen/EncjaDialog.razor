@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Rdzen

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Typ encji"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.TypEncji" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Kod encji"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  ReadOnly="IsReadOnly"
                                  @bind-Value="Model.KodEncji" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Edit">Edytuj</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Zamknij</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EncjaDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;


    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private void Cancel() => MudDialog.Cancel();

    private void Edit() => MudDialog.Close(DialogResult.Ok(new DialogActionResult(DialogAction.Edit)));

    private async Task Submit()
    {
        if (_isReadOnly)
            return;

        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid)
            {
                return;
            }
        }

        MudDialog.Close(DialogResult.Ok(Model));
    }
}