@page "/dokumenty"
@attribute [Authorize(Roles = RoleCodes.AdminOrManagerOrEmployee)]

@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using CastlePlus2.Client.Services.Dokumenty
@using CastlePlus2.Contracts.DTOs.Dokumenty
@using CastlePlus2.Contracts.Requests.Dokumenty
@inject IDokumentyService DokumentyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Dokumenty</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista Dokumentów</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="@ReloadFromUrlAsync"
                           Class="mr-2" />

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
                </MudButton>

            </AuthorizeView>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Nazwa</MudTh>
            <MudTh>Ścieżka</MudTh>
            <MudTh>Owner</MudTh>
            <MudTh>Data</MudTh>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">
                <MudTh></MudTh>
            </AuthorizeView>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.IdDokumentu</MudTd>
            <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
            <MudTd DataLabel="Ścieżka">@context.SciezkaPliku</MudTd>
            <MudTd DataLabel="Owner">@context.IdEncjiOwner</MudTd>
            <MudTd DataLabel="Data">@context.DataUtworzenia.ToString("yyyy-MM-dd HH:mm")</MudTd>

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee" Context="authContext">


                <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
                </MudTd>


            </AuthorizeView>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<DokumentDto> _items = new();
    private string _search = string.Empty;
    private bool _loading = true;

    // Klucz ostatnio załadowanego "stanu URL", żeby nie przeładowywać w kółko
    private string? _loadedUrlKey;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    // NOWE: exact-id – ma zwrócić dokładnie 1 dokument
    [Parameter]
    [SupplyParameterFromQuery(Name = "id")]
    public long? DokumentId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ReloadFromUrlAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var currentKey = BuildUrlKey();
        if (!string.Equals(_loadedUrlKey, currentKey, StringComparison.Ordinal))
        {
            await ReloadFromUrlAsync();
        }
    }

    private string BuildUrlKey()
        => $"{(DokumentId.HasValue ? DokumentId.Value.ToString() : "")}|{(SearchQuery ?? "")}";

    private async Task ReloadFromUrlAsync()
    {
        _loading = true;

        try
        {
            _loadedUrlKey = BuildUrlKey();

            // 1) TRYB EXACT: /dokumenty?id=2004 -> tylko dokument 2004 (albo 0 rekordów)
            if (DokumentId.HasValue && DokumentId.Value > 0)
            {
                _search = DokumentId.Value.ToString();

                var doc = await DokumentyService.GetByIdAsync(DokumentId.Value);
                _items = doc is null ? new List<DokumentDto>() : new List<DokumentDto> { doc };

                await InvokeAsync(StateHasChanged);
                return;
            }

            // 2) TRYB SEARCH: /dokumenty?search=...
            if (!string.IsNullOrWhiteSpace(SearchQuery))
                _search = SearchQuery;

            var data = await DokumentyService.GetAllAsync(SearchQuery);
            _items = (data ?? new List<DokumentDto>()).ToList();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania dokumentów: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Pozostawiamy lokalny filtr tabeli (działa na już pobranych _items)
    private bool FilterFunc(DokumentDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return item.IdDokumentu.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || (item.Nazwa?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.SciezkaPliku?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Opis?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.IdEncjiOwner?.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    // Nadal możesz ręcznie przeładować wyniki po wpisaniu w pole _search:
    // to jest "fuzzy" po backendzie, więc może zwrócić więcej rekordów (tak jak chciałeś uniknąć przy klikaniu z newsów)
    private async Task ReloadAsync(string? searchOverride = null)
    {
        _loading = true;

        try
        {
            if (searchOverride is not null)
                _search = searchOverride;

            var data = await DokumentyService.GetAllAsync(searchOverride);
            _items = (data ?? new List<DokumentDto>()).ToList();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania dokumentów: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters
        {
            ["Model"] = new DokumentDto(),
            ["IsEdit"] = false
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = DialogService.Show<DokumentDialog>("Dodaj dokument", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DokumentDto model)
        {
            try
            {
                var created = await DokumentyService.CreateAsync(new CreateDokumentRequest
                {
                    IdEncjiOwner = model.IdEncjiOwner,
                    Nazwa = model.Nazwa,
                    Opis = model.Opis,
                    SciezkaPliku = model.SciezkaPliku
                });

                Snackbar.Add($"Dodano dokument (Id={created.IdDokumentu}).", Severity.Success);
                await ReloadFromUrlAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Błąd dodawania: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditAsync(DokumentDto item)
    {
        var clone = new DokumentDto
        {
            IdDokumentu = item.IdDokumentu,
            IdEncjiOwner = item.IdEncjiOwner,
            Nazwa = item.Nazwa,
            Opis = item.Opis,
            SciezkaPliku = item.SciezkaPliku,
            DataUtworzenia = item.DataUtworzenia
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = DialogService.Show<DokumentDialog>("Edytuj dokument", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DokumentDto model)
        {
            try
            {
                var ok = await DokumentyService.UpdateAsync(model.IdDokumentu, new UpdateDokumentRequest
                {
                    IdEncjiOwner = model.IdEncjiOwner,
                    Nazwa = model.Nazwa,
                    Opis = model.Opis,
                    SciezkaPliku = model.SciezkaPliku
                });

                if (!ok)
                {
                    Snackbar.Add("Nie znaleziono rekordu (404).", Severity.Warning);
                    return;
                }

                Snackbar.Add("Zapisano zmiany.", Severity.Success);
                await ReloadFromUrlAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ViewAsync(DokumentDto item)
    {
        var clone = new DokumentDto
        {
            IdDokumentu = item.IdDokumentu,
            Nazwa = item.Nazwa,
            SciezkaPliku = item.SciezkaPliku,
            Opis = item.Opis,
            IdEncjiOwner = item.IdEncjiOwner,
            DataUtworzenia = item.DataUtworzenia
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true,
            ["IsReadOnly"] = true
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = DialogService.Show<DokumentDialog>("Podgląd dokumentu", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DialogActionResult { Action: DialogAction.Edit })
        {
            await EditAsync(item);
        }
    }

    private async Task DeleteAsync(DokumentDto item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć dokument Id={item.IdDokumentu}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirm != true) return;

        try
        {
            var ok = await DokumentyService.DeleteAsync(item.IdDokumentu);
            if (!ok)
            {
                Snackbar.Add("Nie znaleziono rekordu (404).", Severity.Warning);
                return;
            }

            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadFromUrlAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}
