@page "/slowniki/waluty"
@attribute [Authorize(Roles = RoleCodes.AdminOrManagerOrEmployee)]

@using MudBlazor
@using CastlePlus2.Client.Services.Slowniki
@using CastlePlus2.Contracts.DTOs.Slowniki
@inject IWalutyService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Waluty</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista walut</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj (kod, nazwa)..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
                </MudButton>

            </AuthorizeView>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Kod</MudTh>
            <MudTh>Nazwa</MudTh>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">
                <MudTh></MudTh>
            </AuthorizeView>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Kod">@context.KodWaluty</MudTd>
            <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee" Context="authContext">

                <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
                </MudTd>

            </AuthorizeView>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private List<WalutaDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var data = await Service.GetAllAsync();
            _items = (data ?? new List<WalutaDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(WalutaDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return (item.KodWaluty?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Nazwa?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters
        {
            ["IsCreate"] = true,
            ["KodWaluty"] = string.Empty,
            ["Nazwa"] = string.Empty
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WalutaDialog>("Dodaj walutę", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled) return;

        Snackbar.Add("Dodano.", Severity.Success);
        await ReloadAsync();
    }

    private async Task EditAsync(WalutaDto item)
    {
        if (string.IsNullOrWhiteSpace(item.KodWaluty))
        {
            Snackbar.Add("Brak kodu waluty – nie można edytować.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["IsCreate"] = false,
            ["KodWaluty"] = item.KodWaluty,
            ["Nazwa"] = item.Nazwa ?? string.Empty
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WalutaDialog>("Edytuj walutę", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled) return;

        Snackbar.Add("Zapisano.", Severity.Success);
        await ReloadAsync();
    }

    private async Task ViewAsync(WalutaDto item)
    {
        if (string.IsNullOrWhiteSpace(item.KodWaluty))
        {
            Snackbar.Add("Brak kodu waluty – nie można podejrzeć.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["IsCreate"] = false,
            ["KodWaluty"] = item.KodWaluty,
            ["Nazwa"] = item.Nazwa ?? string.Empty,
            ["IsReadOnly"] = true
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WalutaDialog>("Podgląd waluty", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is DialogActionResult { Action: DialogAction.Edit })
        {
            await EditAsync(item);
        }
    }

    private async Task DeleteAsync(WalutaDto item)
    {
        if (string.IsNullOrWhiteSpace(item.KodWaluty))
        {
            Snackbar.Add("Brak kodu waluty – nie można usunąć.", Severity.Error);
            return;
        }

        var ok = await DialogService.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć walutę: {item.KodWaluty} – {item.Nazwa}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (ok != true) return;

        try
        {
            await Service.DeleteAsync(item.KodWaluty);
            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}