﻿@using CastlePlus2.Client.Services.Common
@using CastlePlus2.Client.Services.Slowniki
@using CastlePlus2.Contracts.Requests.Slownik
@inject IIndeksacjeService Service
@inject ISnackbar Snackbar

<MudDialog Class="glass-panel">
    <DialogContent>
        <MudForm @ref="_form">
            <MudText Typo="Typo.h6" Class="mb-3">
                @(_isReadOnly ? "Podgląd indeksacji" : _isEdit ? "Edycja indeksacji" : "Nowa indeksacja")
            </MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_kod"
                                  Label="Kod indeksacji"
                                  Required="true"
                                  Disabled="@(_isEdit || _isReadOnly)"
                                  MaxLength="20"
                                  HelperText="Maks. 20 znaków"
                                  Error="@HasError("KodIndeksacji")"
                                  ErrorText="@GetErrorText("KodIndeksacji")" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nazwa"
                                  Label="Nazwa"
                                  Required="true"
                                  Disabled="_isReadOnly"
                                  MaxLength="100"
                                  HelperText="Maks. 100 znaków"
                                  Error="@HasError("Nazwa")"
                                  ErrorText="@GetErrorText("Nazwa")" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_url"
                                  Label="Adres źródła URL"
                                  Required="false"
                                  Disabled="_isReadOnly"
                                  MaxLength="400"
                                  HelperText="Maks. 400 znaków"
                                  Error="@HasError("AdresZrodlaURL")"
                                  ErrorText="@GetErrorText("AdresZrodlaURL")" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@(_isReadOnly ? "Zamknij" : "Anuluj")</MudButton>
        @if (!_isReadOnly)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? KodIndeksacji { get; set; }
    [Parameter] public string? Nazwa { get; set; }
    [Parameter] public string? AdresZrodlaURL { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm _form = default!;
    private string _kod = string.Empty;
    private string _nazwa = string.Empty;
    private string? _url;
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private bool _isEdit => !string.IsNullOrWhiteSpace(KodIndeksacji);
    private bool _isReadOnly => IsReadOnly;

    protected override void OnInitialized()
    {
        if (_isEdit)
        {
            _kod = KodIndeksacji!;
            _nazwa = Nazwa ?? string.Empty;
            _url = AdresZrodlaURL;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (_isReadOnly)
            return;

        await _form.Validate();
        if (!_form.IsValid) return;



        _fieldErrors.Clear();

        try
        {
            _kod = _kod.Trim();
            _nazwa = _nazwa.Trim();
            _url = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim();

            if (_isEdit)
            {
                await Service.UpdateAsync(_kod, new UpdateIndeksacjaRequest
                {
                    Nazwa = _nazwa,
                    AdresZrodlaURL = _url
                });
            }
            else
            {
                await Service.CreateAsync(new CreateIndeksacjaRequest
                {
                    KodIndeksacji = _kod,
                    Nazwa = _nazwa,
                    AdresZrodlaURL = _url
                });
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiValidationException ex)
        {
            ApplyFieldErrors(ex.Errors);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu indeksacji: {ex.Message}", Severity.Error);
        }
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? GetErrorText(string field)
        => _fieldErrors.TryGetValue(field, out var text) ? text : null;

    private void ApplyFieldErrors(IReadOnlyDictionary<string, string[]> errors)
    {
        _fieldErrors.Clear();

        foreach (var (key, messages) in errors)
        {
            if (messages.Length == 0) continue;
            _fieldErrors[key] = string.Join(" ", messages);
        }
    }
}
