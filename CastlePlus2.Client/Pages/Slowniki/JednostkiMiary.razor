@page "/slowniki/jednostki-miary"
@attribute [Authorize(Roles = RoleCodes.AdminOrEmployee)]

@using MudBlazor
@using CastlePlus2.Client.Services.Slowniki
@using CastlePlus2.Contracts.DTOs.Slowniki
@inject IJednostkiMiaryService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Jednostki miary</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista jednostek miary</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj (kod, nazwa)..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Kod</MudTh>
            <MudTh>Nazwa</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Kod">@context.KodJednostki</MudTd>
            <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
            <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private List<JednostkaMiaryDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var data = await Service.GetAllAsync();
            _items = (data ?? new List<JednostkaMiaryDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(JednostkaMiaryDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return (item.KodJednostki?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Nazwa?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task CreateAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<JednostkaMiaryDialog>("Dodaj jednostkę miary", options: options);

        var res = await dialog.Result;
        if (!res.Canceled)
        {
            Snackbar.Add("Dodano.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditAsync(JednostkaMiaryDto item)
    {
        var parameters = new DialogParameters
        {
            ["KodJednostki"] = item.KodJednostki,
            ["Nazwa"] = item.Nazwa
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<JednostkaMiaryDialog>("Edytuj jednostkę miary", parameters, options);

        var res = await dialog.Result;
        if (!res.Canceled)
        {
            Snackbar.Add("Zapisano.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(JednostkaMiaryDto item)
    {
        var ok = await DialogService.ShowMessageBox(
            "Usuń",
            $"Usunąć '{item.KodJednostki}'?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (ok == true)
        {
            try
            {
                await Service.DeleteAsync(item.KodJednostki);
                Snackbar.Add("Usunięto.", Severity.Success);
                await ReloadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
            }
        }
    }
}
}
