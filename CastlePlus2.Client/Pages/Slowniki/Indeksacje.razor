@page "/slowniki/indeksacje"
@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Slowniki
@using CastlePlus2.Contracts.Requests.Slownik
@using CastlePlus2.Client.Services.Slowniki
@inject IIndeksacjeService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Indeksacje</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista Indeksacji</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
            </MudButton>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Kod</MudTh>
            <MudTh>Nazwa</MudTh>
            <MudTh>Źródło URL</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Kod">
                <MudChip T="string"
                         Variant="Variant.Outlined"
                         Color="Color.Primary"
                         Size="Size.Small">
                    @context.KodIndeksacji
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Nazwa">@context.Nazwa</MudTd>
            <MudTd DataLabel="Źródło URL">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(string.IsNullOrWhiteSpace(context.AdresZrodlaURL) ? "-" : context.AdresZrodlaURL)
                </MudText>
            </MudTd>

            <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

    </MudTable>
</MudPaper>

@code {
    private List<IndeksacjaDto> _items = new();
    private string _search = string.Empty;
    private bool _loading = true; // Standardowa obsługa loadingu

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync();
            _items = (result ?? new List<IndeksacjaDto>()).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(IndeksacjaDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return (item.KodIndeksacji?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.Nazwa?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || (item.AdresZrodlaURL?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters
        {
            ["KodIndeksacji"] = string.Empty,
            ["Nazwa"] = string.Empty,
            ["AdresZrodlaURL"] = string.Empty
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialogs.ShowAsync<IndeksacjaDialog>("Dodaj indeksację", parameters, options);
        var result = await dialog.Result;

        // Jeśli okno dialogowe zwróciło true (sukces zapisu), przeładuj listę
        if (!result.Canceled && result.Data is true)
        {
            Snackbar.Add("Dodano indeksację.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditAsync(IndeksacjaDto item)
    {
        var parameters = new DialogParameters
        {
            ["KodIndeksacji"] = item.KodIndeksacji,
            ["Nazwa"] = item.Nazwa,
            ["AdresZrodlaURL"] = item.AdresZrodlaURL
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialogs.ShowAsync<IndeksacjaDialog>("Edytuj indeksację", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is true)
        {
            Snackbar.Add("Zapisano zmiany.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(IndeksacjaDto item)
    {
        bool? confirm = await Dialogs.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć indeksację '{item.KodIndeksacji}'?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirm != true) return;

        try
        {
            await Service.DeleteAsync(item.KodIndeksacji);
            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}