﻿@using CastlePlus2.Client.Services.Common
@using CastlePlus2.Client.Services.Slowniki
@using CastlePlus2.Contracts.Requests.Slownik
@using MudBlazor
@inject IWalutyService Service
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudText Typo="Typo.h6" Class="mb-3">
                @(_isReadOnly ? "Podgląd waluty" : _isCreate ? "Nowa waluta" : "Edycja waluty")
            </MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    @if (_isCreate)
                    {
                        <MudTextField @bind-Value="KodWaluty"
                                      Label="Kod waluty"
                                      Required="true"
                                      Immediate="true"
                                      MaxLength="3"
                                      HelperText="Dokładnie 3 znaki"
                                      Disabled="IsReadOnly"
                                      Error="@HasError(nameof(KodWaluty))"
                                      ErrorText="@GetErrorText(nameof(KodWaluty))" />
                    }
                    else
                    {
                        <MudTextField Value="@KodWaluty"
                                      Label="Kod waluty"
                                      Disabled="true" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Nazwa"
                                  Label="Nazwa"
                                  Required="true"
                                  Immediate="true"
                                  MaxLength="50"
                                  HelperText="Maks. 50 znaków"
                                  Disabled="IsReadOnly"
                                  Error="@HasError(nameof(Nazwa))"
                                  ErrorText="@GetErrorText(nameof(Nazwa))" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@(_isReadOnly ? "Zamknij" : "Anuluj")</MudButton>
        @if (!_isReadOnly)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool IsCreate { get; set; } = true;
    [Parameter] public bool IsReadOnly { get; set; } = false;

    [Parameter] public string KodWaluty { get; set; } = string.Empty;
    [Parameter] public string Nazwa { get; set; } = string.Empty;

    private MudForm _form = default!;
    private bool _isCreate => IsCreate;
    private bool _isReadOnly => IsReadOnly;
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (_isReadOnly)
            return;

        await _form.Validate();
        if (!_form.IsValid) return;

        _fieldErrors.Clear();

        KodWaluty = (KodWaluty ?? string.Empty).Trim().ToUpperInvariant();
        Nazwa = (Nazwa ?? string.Empty).Trim();

        try
        {
            if (_isCreate)
            {
                await Service.CreateAsync(new CreateWalutaRequest
                {
                    KodWaluty = KodWaluty,
                    Nazwa = Nazwa
                });
            }
            else
            {
                await Service.UpdateAsync(KodWaluty, new UpdateWalutaRequest
                {
                    Nazwa = Nazwa
                });
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiValidationException ex)
        {
            ApplyFieldErrors(ex.Errors);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu waluty: {ex.Message}", Severity.Error);
        }
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? GetErrorText(string field)
        => _fieldErrors.TryGetValue(field, out var text) ? text : null;

    private void ApplyFieldErrors(IReadOnlyDictionary<string, string[]> errors)
    {
        _fieldErrors.Clear();

        foreach (var (key, messages) in errors)
        {
            if (messages.Length == 0) continue;
            _fieldErrors[key] = string.Join(" ", messages);
        }
    }
}
