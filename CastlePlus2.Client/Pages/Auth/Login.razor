@page "/login"
@page "/auth/login"
@layout CastlePlus2.Client.Shared.AuthLayout

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudPaper Class="pa-6 glass-card" Elevation="0">
    <MudForm @ref="_form">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">Logowanie</MudText>
            <MudTextField @bind-Value="_loginOrEmail"
                          Label="Login lub email"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Login lub email jest wymagany"
                          Immediate="true" />
            <MudTextField @bind-Value="_password"
                          Label="Hasło"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword? InputType.Text: InputType.Password)"
                          Required="true"
                          RequiredError="Hasło jest wymagane"
                          Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="Pokaż lub ukryj hasło"
                          OnAdornmentClick="TogglePasswordVisibility"
                          @onkeydown="HandlePasswordKeyDown" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandleLoginAsync"
                       Disabled="_isSubmitting">
                Zaloguj
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       Disabled="_isSubmitting"
                       OnClick="@(() => Nav.NavigateTo("/auth/request-access"))">
                Poproś o dostęp
            </MudButton>

        </MudStack>
    </MudForm>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private MudForm? _form;
    private string _loginOrEmail = string.Empty;
    private string _password = string.Empty;
    private bool _isSubmitting;
    private bool _showPassword;

    private void TogglePasswordVisibility()
        => _showPassword = !_showPassword;

    private async Task HandlePasswordKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await HandleLoginAsync();
        }
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting || _form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Uzupełnij wymagane pola.", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            await AuthService.LoginAsync(_loginOrEmail, _password, "client");
            await AuthStateProvider.MarkUserAsAuthenticatedFromTokenAsync();

            var redirectUrl = ResolveReturnUrl();
            Nav.NavigateTo(redirectUrl, replace: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się zalogować: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string ResolveReturnUrl()
    {
        // Domyślnie idziemy na "/" i Home.razor przekieruje po roli
        if (string.IsNullOrWhiteSpace(ReturnUrl))
            return "/";

        // Nie zawracamy na login
        if (ReturnUrl.Equals("/auth/login", StringComparison.OrdinalIgnoreCase)
            || ReturnUrl.Equals("/login", StringComparison.OrdinalIgnoreCase))
            return "/";

        // Security: tylko lokalne ścieżki
        if (ReturnUrl.StartsWith("/", StringComparison.Ordinal)
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal))
            return ReturnUrl;

        return "/";
    }
}