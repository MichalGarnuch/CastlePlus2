@page "/register"
@page "/auth/register"
@layout CastlePlus2.Client.Shared.AuthLayout

@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="pa-8 glass-card">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" Class="fw-700">Rejestracja została wyłączona</MudText>
        <MudText Typo="Typo.body2" Class="opacity-80">
            Konto może utworzyć wyłącznie administrator po akceptacji prośby o dostęp.
        </MudText>

        <MudDivider Class="my-2" />

        <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween" Class="mt-2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       OnClick="@(() => Nav.NavigateTo("/auth/login"))">
                Wróć do logowania
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       OnClick="@(() => Nav.NavigateTo("/auth/request-access"))">
                Poproś o dostęp
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    protected override void OnInitialized()
    {
        Snackbar.Add("Publiczna rejestracja jest wyłączona. Użyj formularza prośby o dostęp.", Severity.Info);
    }
}