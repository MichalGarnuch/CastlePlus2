@page "/profil/zmien-haslo"
@attribute [Authorize]

@using CastlePlus2.Client.Services.Auth
@using CastlePlus2.Client.Services.Auth.State
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="pa-4 glass-card" Elevation="0">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5" Class="fw-700">Zmiana hasła</MudText>

        <MudTextField @bind-Value="_currentPassword"
                      Label="Aktualne hasło"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true" />

        <MudTextField @bind-Value="_newPassword"
                      Label="Nowe hasło"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true" />

        <MudTextField @bind-Value="_confirmNewPassword"
                      Label="Potwierdź nowe hasło"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_saving"
                   OnClick="SaveAsync">
            Zmień hasło
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmNewPassword = string.Empty;
    private bool _saving;

    private async Task SaveAsync()
    {
        if (_saving)
            return;

        if (_newPassword.Length < 8)
        {
            Snackbar.Add("Nowe hasło musi mieć co najmniej 8 znaków.", Severity.Warning);
            return;
        }

        if (!string.Equals(_newPassword, _confirmNewPassword, StringComparison.Ordinal))
        {
            Snackbar.Add("Potwierdzenie nowego hasła musi być zgodne z nowym hasłem.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPassword, _newPassword, _confirmNewPassword);

            // Czyścimy sesję lokalnie (tokeny + auth state)
            await AuthService.LogoutAsync();
            await AuthStateProvider.MarkUserAsLoggedOutAsync();

            Snackbar.Add("Hasło zostało zmienione. Zaloguj się ponownie.", Severity.Success);
            Navigation.NavigateTo("/auth/login", replace: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się zmienić hasła: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}