@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Najem
@using CastlePlus2.Contracts.DTOs.Rdzen
@using CastlePlus2.Client.Pages.Najem
@using CastlePlus2.Client.Pages.Rdzen
@using CastlePlus2.Client.Services.Najem
@using CastlePlus2.Client.Services.Rdzen
@inject IDialogService DialogService
@inject IUmowyNajmuService UmowyNajmuService
@inject IEncjeService EncjeService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudText Typo="Typo.h6" Class="mb-3">
                @(_isReadOnly ? "Podgląd przedmiotu najmu" : _isEdit ? "Edycja przedmiotu najmu" : "Nowy przedmiot najmu")
            </MudText>

            <MudGrid Spacing="2">
                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@Model.IdPrzedmiotuNajmu.ToString()"
                                      Label="IdPrzedmiotuNajmu"
                                      Disabled="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Umowa najmu"
                                  Required="true"
                                  RequiredError="Umowa jest wymagana"
                                  ReadOnly="true"
                                  Margin="Margin.Dense"
                                  Value="@_umowaLabel"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="OpenUmowaLookupDialog" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Encja"
                                  Required="true"
                                  RequiredError="Encja jest wymagana"
                                  ReadOnly="true"
                                  Margin="Margin.Dense"
                                  Value="@_encjaLabel"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="OpenEncjaLookupDialog" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Udział procent (opcjonalnie)"
                                     Margin="Margin.Dense"
                                     Disabled="IsReadOnly"
                                     @bind-Value="Model.UdzialProcent" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Od dnia"
                                   Date="@_odDnia"
                                   DateChanged="OnOdDniaChanged"
                                   Margin="Margin.Dense"
                                   Disabled="IsReadOnly"
                                   Required="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Do dnia (opcjonalnie)"
                                   Date="@_doDnia"
                                   DateChanged="OnDoDniaChanged"
                                   Disabled="IsReadOnly"
                                   Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@(_isReadOnly ? "Zamknij" : "Anuluj")</MudButton>
        @if (!_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PrzedmiotNajmuDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private string _umowaLabel = string.Empty;
    private string _encjaLabel = string.Empty;
    private DateTime? _odDnia;
    private DateTime? _doDnia;

    protected override async Task OnInitializedAsync()
    {
        _odDnia = new DateTime(Model.OdDnia.Year, Model.OdDnia.Month, Model.OdDnia.Day);
        _doDnia = Model.DoDnia is null
            ? null
            : new DateTime(Model.DoDnia.Value.Year, Model.DoDnia.Value.Month, Model.DoDnia.Value.Day);

        await LoadLabelsAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnOdDniaChanged(DateTime? dt)
    {
        if (_isReadOnly)
            return;

        _odDnia = dt;
        if (dt is not null)
            Model.OdDnia = DateOnly.FromDateTime(dt.Value);
    }

    private void OnDoDniaChanged(DateTime? dt)
    {
        if (_isReadOnly)
            return;

        _doDnia = dt;
        Model.DoDnia = dt is null ? null : DateOnly.FromDateTime(dt.Value);
    }

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private async Task LoadLabelsAsync()
    {
        if (Model.IdUmowyNajmu != Guid.Empty)
        {
            var umowa = await UmowyNajmuService.GetByIdAsync(Model.IdUmowyNajmu);
            _umowaLabel = umowa is null ? Model.IdUmowyNajmu.ToString() : $"{umowa.NumerUmowy} ({umowa.DataPoczatku:yyyy-MM-dd})";
        }

        if (Model.IdEncji != Guid.Empty)
        {
            var encja = await EncjeService.GetByIdAsync(Model.IdEncji);
            _encjaLabel = encja is null
                ? Model.IdEncji.ToString()
                : string.IsNullOrWhiteSpace(encja.KodEncji)
                    ? encja.TypEncji
                    : $"{encja.TypEncji} / {encja.KodEncji}";
        }
    }

    private async Task OpenUmowaLookupDialog()
    {
        if (_isReadOnly)
            return;

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<UmowaNajmuLookupDialog>("Wybierz umowę", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not UmowaNajmuLookupDto selected)
            return;

        Model.IdUmowyNajmu = selected.IdUmowy;
        _umowaLabel = selected.Label;
    }

    private async Task OpenEncjaLookupDialog()
    {
        if (_isReadOnly)
            return;

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<EncjaLookupDialog>("Wybierz encję", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not EncjaLookupDto selected)
            return;

        Model.IdEncji = selected.IdEncji;
        _encjaLabel = selected.Label;
    }
}