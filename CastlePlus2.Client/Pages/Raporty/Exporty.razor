@page "/raporty/eksporty"

@using CastlePlus2.Client.Services.Exports
@using CastlePlus2.Client.Services.Reports
@using CastlePlus2.Contracts.Exports
@using CastlePlus2.Contracts.Reports
@using MudBlazor
@using System.Linq
@inject IReportExportUrlService ReportExportUrlService
@inject IReportDataPreviewService ReportDataPreviewService
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Eksporty raportów</MudText>

<MudPaper Class="pa-4 glass-panel">
    <MudGrid Spacing="3">

        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Raport" Dense="true" @bind-Value="_selectedReportKey">
                @foreach (var option in _reportOptions)
                {
                    <MudSelectItem Value="@option.Key">@option.Label</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mt-1">@_selectedDescription</MudText>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="ExportFormat" Label="Format eksportu" Dense="true" @bind-Value="_selectedFormat">
                <MudSelectItem Value="ExportFormat.Csv">CSV</MudSelectItem>
                <MudSelectItem Value="ExportFormat.Xlsx">XLSX</MudSelectItem>
                <MudSelectItem Value="ExportFormat.Pdf">PDF</MudSelectItem>
                <MudSelectItem Value="ExportFormat.Docx">DOCX</MudSelectItem>
            </MudSelect>
        </MudItem>

        <!-- ARCHIWIZACJA: sterowanie ręczne, nie przez @bind -->
        <MudItem xs="12" md="6">
            <MudSwitch T="bool"
                       Color="Color.Secondary"
                       Label="Archiwizuj na serwerze (retencja 30 dni)"
                       Checked="@_archive"
                       @onclick="ToggleArchive" />
            <MudText Typo="Typo.caption" Class="mt-1">
                Gdy włączone: API zapisze kopię w App_Data/Exports/... i nadal pobierzesz plik normalnie.
            </MudText>

            <!-- DEBUG: to MUSI zmieniać się na true/false -->
            <MudText Typo="Typo.caption" Class="mt-1">
                DEBUG: archive=@(_archive ? "true" : "false")
            </MudText>
        </MudItem>

        <MudItem xs="12">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="StartExport"
                       Disabled="@string.IsNullOrWhiteSpace(_selectedReportKey)">
                Pobierz raport
            </MudButton>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="int"
                       Label="Liczba wierszy podglądu"
                       Dense="true"
                       @bind-Value="_previewTake">
                <MudSelectItem Value="20">20</MudSelectItem>
                <MudSelectItem Value="50">50</MudSelectItem>
                <MudSelectItem Value="100">100</MudSelectItem>
                <MudSelectItem Value="200">200</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="LoadPreviewAsync"
                       Disabled="@string.IsNullOrWhiteSpace(_selectedReportKey)">
                Podgląd danych
            </MudButton>
        </MudItem>

    </MudGrid>
</MudPaper>

@if (_previewLoading)
{
    <MudPaper Class="pa-4 mt-4">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="mt-2">Ładowanie podglądu danych...</MudText>
    </MudPaper>
}
else if (_previewResponse is not null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">@_previewResponse.Title</MudText>
        <MudText Typo="Typo.caption" Class="mb-4">
            Wygenerowano: @_previewResponse.GeneratedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </MudText>

        @if (_previewResponse.Summary is not null)
        {
            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var entry in _previewResponse.Summary)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudPaper Class="pa-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Key</MudText>
                            <MudText Typo="Typo.subtitle2">@entry.Value</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudTable Items="_previewResponse.Rows"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true">
            <HeaderContent>
                @foreach (var column in _previewResponse.Columns)
                {
                    <MudTh>@column</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                @foreach (var cell in context)
                {
                    <MudTd>@cell</MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">Brak danych do wyświetlenia.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private readonly IReadOnlyList<ReportOption> _reportOptions = new List<ReportOption>
    {
        new("podsumowanie", "Podsumowanie operacyjne", "Podstawowe wskaźniki demonstracyjne."),
        new("faktury", "Statystyki faktur", "Zestawienie przykładowych danych finansowych.")
    };

    private string? _selectedReportKey;
    private ExportFormat _selectedFormat = ExportFormat.Csv;

    private bool _archive;
    private int _previewTake = 50;
    private bool _previewLoading;
    private ReportDataPreviewResponse? _previewResponse;

    private string _selectedDescription =>
        _reportOptions.FirstOrDefault(option => option.Key == _selectedReportKey)?.Description ?? string.Empty;

    protected override void OnInitialized()
    {
        _selectedReportKey ??= _reportOptions.FirstOrDefault()?.Key;
        _archive = ReadBoolQuery("archive");
    }

    private void ToggleArchive()
    {
        _archive = !_archive;

        // utrwalenie stanu w URL strony (bez pełnego przeładowania)
        var target = _archive ? "/raporty/eksporty?archive=true" : "/raporty/eksporty";
        Nav.NavigateTo(target, replace: true);

        StateHasChanged();
    }

    private void StartExport()
    {
        if (string.IsNullOrWhiteSpace(_selectedReportKey))
            return;

        var parameters = new Dictionary<string, string?>
        {
            ["reportKey"] = _selectedReportKey,
            ["format"] = _selectedFormat.ToString(),
            // ZAWSZE wysyłamy, żebyś widział w Network:
            ["archive"] = _archive ? "true" : "false"
        };

        ReportExportUrlService.OpenExportUrl("/api/raporty/eksport", parameters);
    }
    private async Task LoadPreviewAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedReportKey))
            return;

        _previewLoading = true;
        try
        {
            _previewResponse = await ReportDataPreviewService.GetPreviewAsync(_selectedReportKey, _previewTake);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd podglądu danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private bool ReadBoolQuery(string key)
    {
        var uri = new Uri(Nav.Uri);
        var q = uri.Query;
        if (string.IsNullOrWhiteSpace(q)) return false;

        var parts = q.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        foreach (var part in parts)
        {
            var kv = part.Split('=', 2);
            if (kv.Length != 2) continue;

            var k = Uri.UnescapeDataString(kv[0]);
            if (!string.Equals(k, key, StringComparison.OrdinalIgnoreCase)) continue;

            var v = Uri.UnescapeDataString(kv[1]);
            return string.Equals(v, "true", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(v, "1", StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private sealed record ReportOption(string Key, string Label, string Description);
}
