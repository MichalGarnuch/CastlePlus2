@page "/finanse/platnosci"
@attribute [Authorize(Roles = RoleCodes.AdminOrManagerOrEmployee)]

@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Finanse
@using CastlePlus2.Contracts.DTOs.Slowniki
@using CastlePlus2.Contracts.Requests.Finanse
@using CastlePlus2.Client.Services.Finanse
@using CastlePlus2.Client.Services.Slowniki

@inject IPlatnosciService PlatnosciService
@inject IWalutyService WalutyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Płatności</MudText>

<MudPaper Class="pa-4">
    <MudTable Items="_items"
              RowsPerPage="20"
              RowsPerPageOptions="new int[] { 20, 50, 100 }"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              Loading="_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Lista Płatności</MudText>
            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Szukaj..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mr-4"
                          Margin="Margin.Dense" />

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Info"
                           AriaLabel="Odśwież"
                           Title="Odśwież"
                           OnClick="ReloadAsync"
                           Class="mr-2" />

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Dodaj
                </MudButton>

            </AuthorizeView>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Data</MudTh>
            <MudTh>Podmiot</MudTh>
            <MudTh>Waluta</MudTh>
            <MudTh class="text-right">Kwota</MudTh>
            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee">
                <MudTh></MudTh>
            </AuthorizeView>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.IdPlatnosci</MudTd>
            <MudTd DataLabel="Data">@context.DataPlatnosci.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Podmiot">@GetPodmiotLabel(context.IdPodmiotu)</MudTd>
            <MudTd DataLabel="Waluta">@context.KodWaluty</MudTd>
            <MudTd DataLabel="Kwota" Class="text-right">@context.Kwota.ToString("0.00")</MudTd>

            <AuthorizeView Roles="@RoleCodes.AdminOrEmployee" Context="authContext">


                <MudTd DataLabel="Akcje" Class="text-right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               Title="Podgląd"
                               OnClick="@(() => ViewAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))" />
                </MudTd>


            </AuthorizeView>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">Brak rekordów.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private List<PlatnoscDto> _items = new();
    private List<WalutaDto> _waluty = new();
    private string _search = string.Empty;
    private bool _loading = true; // 2. DODANO ZMIENNĄ

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await ReloadAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            _waluty = (await WalutyService.GetAllAsync()) ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd ładowania słowników: {ex.Message}", Severity.Error);
            _waluty = new();
        }
    }

    private async Task ReloadAsync()
    {
        // 3. OBSŁUGA STANU ŁADOWANIA
        _loading = true;
        try
        {
            _items = (await PlatnosciService.GetAllAsync()) ?? new();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania płatności: {ex.Message}", Severity.Error);
            _items = new();
        }
        finally
        {
            _loading = false; // Zawsze wyłącz na końcu
        }
    }

    private static string GetPodmiotLabel(long idPodmiotu)
        => $"Id={idPodmiotu}";

    private bool FilterFunc(PlatnoscDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var s = _search.Trim();

        return item.IdPlatnosci.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || item.IdPodmiotu.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
               || item.DataPlatnosci.ToString("yyyy-MM-dd").Contains(s, StringComparison.OrdinalIgnoreCase)
               || (item.KodWaluty?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
               || item.Kwota.ToString("0.00").Contains(s, StringComparison.OrdinalIgnoreCase)
               || GetPodmiotLabel(item.IdPodmiotu).Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private async Task CreateAsync()
    {
        var model = new PlatnoscDto
        {
            DataPlatnosci = DateTime.Today,
            KodWaluty = "PLN"
        };

        var parameters = new DialogParameters
        {
            ["Model"] = model,
            ["IsEdit"] = false,
            ["Waluty"] = _waluty
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<PlatnoscDialog>("Nowa płatność", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not PlatnoscDto dto)
            return;

        try
        {
            var created = await PlatnosciService.CreateAsync(new CreatePlatnoscRequest
            {
                IdPodmiotu = dto.IdPodmiotu,
                DataPlatnosci = dto.DataPlatnosci,
                KodWaluty = dto.KodWaluty,
                Kwota = dto.Kwota
            });

            _items.Insert(0, created);
            Snackbar.Add("Dodano płatność.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd dodawania płatności: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(PlatnoscDto item)
    {
        var clone = new PlatnoscDto
        {
            IdPlatnosci = item.IdPlatnosci,
            IdPodmiotu = item.IdPodmiotu,
            DataPlatnosci = item.DataPlatnosci,
            KodWaluty = item.KodWaluty,
            Kwota = item.Kwota
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true,
            ["Waluty"] = _waluty
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<PlatnoscDialog>("Edycja płatności", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not PlatnoscDto dto)
            return;

        try
        {
            var ok = await PlatnosciService.UpdateAsync(item.IdPlatnosci, new UpdatePlatnoscRequest
            {
                IdPodmiotu = dto.IdPodmiotu,
                DataPlatnosci = dto.DataPlatnosci,
                KodWaluty = dto.KodWaluty,
                Kwota = dto.Kwota
            });

            if (!ok)
            {
                Snackbar.Add("Rekord nie istnieje (404).", Severity.Warning);
                await ReloadAsync();
                return;
            }

            var idx = _items.FindIndex(x => x.IdPlatnosci == item.IdPlatnosci);
            if (idx >= 0)
            {
                // Aktualizujemy obiekt w pamięci, żeby uniknąć pełnego przeładowania, jeśli chcemy
                // Ale ponieważ mamy ReloadAsync() na końcu (opcjonalnie), to i tak się odświeży.
                // Tutaj dla spójności przypisujemy wartości z dto do listy.
                _items[idx] = new PlatnoscDto
                {
                    IdPlatnosci = item.IdPlatnosci,
                    IdPodmiotu = dto.IdPodmiotu,
                    DataPlatnosci = dto.DataPlatnosci,
                    KodWaluty = dto.KodWaluty,
                    Kwota = dto.Kwota
                };
            }

            Snackbar.Add("Zapisano zmiany.", Severity.Success);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewAsync(PlatnoscDto item)
    {
        var clone = new PlatnoscDto
        {
            IdPlatnosci = item.IdPlatnosci,
            IdPodmiotu = item.IdPodmiotu,
            DataPlatnosci = item.DataPlatnosci,
            KodWaluty = item.KodWaluty,
            Kwota = item.Kwota
        };

        var parameters = new DialogParameters
        {
            ["Model"] = clone,
            ["IsEdit"] = true,
            ["IsReadOnly"] = true,
            ["Waluty"] = _waluty
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<PlatnoscDialog>("Podgląd płatności", parameters, options);
        await dialog.Result;
    }

    private async Task DeleteAsync(PlatnoscDto item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Usuń",
            $"Czy na pewno usunąć płatność Id={item.IdPlatnosci}?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirm != true)
            return;

        try
        {
            var ok = await PlatnosciService.DeleteAsync(item.IdPlatnosci);
            if (!ok)
            {
                Snackbar.Add("Rekord nie istnieje (404).", Severity.Warning);
                await ReloadAsync();
                return;
            }

            _items.RemoveAll(x => x.IdPlatnosci == item.IdPlatnosci);
            Snackbar.Add("Usunięto.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd usuwania: {ex.Message}", Severity.Error);
        }
    }
}