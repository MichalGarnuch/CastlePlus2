@page "/finanse/platnosci/zarejestruj"
@attribute [Authorize(Roles = RoleCodes.AdminOrEmployee)]

@using System.Linq
@using MudBlazor
@using CastlePlus2.Client.Services.Finanse
@using CastlePlus2.Contracts.DTOs.Finanse
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Contracts.Requests.Finanse
@inject IProcesyFinanseService ProcesyFinanseService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Rejestracja płatności</MudText>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="long"
                               Label="Podmiot"
                               Required="true"
                               RequiredError="Podmiot jest wymagany"
                               @bind-Value="_model.IdPodmiotu"
                               Margin="Margin.Dense">
                        @foreach (var podmiot in _context.Podmioty)
                        {
                            <MudSelectItem T="long" Value="@podmiot.IdPodmiotu">@GetPodmiotLabel(podmiot)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data płatności"
                                   Required="true"
                                   RequiredError="Data płatności jest wymagana"
                                   @bind-Date="_dataPlatnosci" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Waluta"
                               Required="true"
                               RequiredError="Waluta jest wymagana"
                               @bind-Value="_model.KodWaluty"
                               Margin="Margin.Dense">
                        @foreach (var waluta in _context.Waluty)
                        {
                            <MudSelectItem T="string" Value="@waluta.KodWaluty">@($"{waluta.KodWaluty} / {waluta.Nazwa}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Label="Kwota płatności"
                                     Required="true"
                                     RequiredError="Kwota płatności jest wymagana"
                                     @bind-Value="_model.Kwota" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Rozliczenia płatności</MudText>

            @for (var i = 0; i < _model.Rozliczenia.Count; i++)
            {
                var rozliczenie = _model.Rozliczenia[i];
                <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid rgba(255,255,255,0.08);">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2">Rozliczenie #@(i + 1)</MudText>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Disabled="@(_model.Rozliczenia.Count == 1)"
                                   OnClick="@(() => RemoveRozliczenie(rozliczenie))">
                            Usuń rozliczenie
                        </MudButton>
                    </MudStack>

                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" sm="8">
                            <MudSelect T="long"
                                       Label="Faktura"
                                       Required="true"
                                       RequiredError="Faktura jest wymagana"
                                       @bind-Value="rozliczenie.IdFaktury"
                                       Margin="Margin.Dense">
                                @foreach (var faktura in GetDostepneFaktury())
                                {
                                    <MudSelectItem T="long" Value="@faktura.IdFaktury">@GetFakturaLabel(faktura)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFakturaInfo(rozliczenie.IdFaktury)</MudText>
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal"
                                             Label="Kwota rozliczenia"
                                             Required="true"
                                             RequiredError="Kwota rozliczenia jest wymagana"
                                             @bind-Value="rozliczenie.Kwota" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="AddRozliczenie">
                Dodaj rozliczenie
            </MudButton>
        </MudForm>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Suma rozliczeń: @_model.Rozliczenia.Sum(x => x.Kwota)</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SubmitAsync"
                   Disabled="@(!_isFormValid || _saving)">
            Zarejestruj płatność
        </MudButton>
    }
</MudPaper>

@code {
    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private bool _isFormValid;
    private DateTime? _dataPlatnosci;
    private PlatnoscContextDto _context = new();
    private ZarejestrujPlatnoscRequest _model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _context = await ProcesyFinanseService.GetPlatnoscContextAsync();
            ResetModel();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać danych kontekstu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetModel()
    {
        _model = new ZarejestrujPlatnoscRequest
        {
            DataPlatnosci = DateTime.Today,
            Rozliczenia = new List<ZarejestrujPlatnoscRozliczenieRequest>
            {
                CreateRozliczenie()
            }
        };

        _dataPlatnosci = _model.DataPlatnosci;
    }

    private static ZarejestrujPlatnoscRozliczenieRequest CreateRozliczenie()
        => new();

    private void AddRozliczenie()
    {
        _model.Rozliczenia.Add(CreateRozliczenie());
    }

    private void RemoveRozliczenie(ZarejestrujPlatnoscRozliczenieRequest rozliczenie)
    {
        if (_model.Rozliczenia.Count <= 1)
        {
            return;
        }

        _model.Rozliczenia.Remove(rozliczenie);
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();
        if (!_isFormValid)
        {
            return;
        }

        if (_dataPlatnosci is null)
        {
            Snackbar.Add("Data płatności jest wymagana.", Severity.Warning);
            return;
        }

        _model.DataPlatnosci = _dataPlatnosci.Value;

        _saving = true;
        try
        {
            var result = await ProcesyFinanseService.ZarejestrujPlatnoscAsync(_model);
            Snackbar.Add($"Zarejestrowano płatność (Id: {result.IdPlatnosci}).", Severity.Success);
            ResetModel();
            await _form.ResetAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się zarejestrować płatności: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private IEnumerable<FakturaDoRozliczeniaDto> GetDostepneFaktury()
    {
        var faktury = _context.Faktury.AsEnumerable();

        if (_model.IdPodmiotu > 0)
        {
            faktury = faktury.Where(x => x.IdPodmiotu == _model.IdPodmiotu);
        }

        if (!string.IsNullOrWhiteSpace(_model.KodWaluty))
        {
            faktury = faktury.Where(x => x.KodWaluty == _model.KodWaluty);
        }

        return faktury;
    }

    private string GetFakturaLabel(FakturaDoRozliczeniaDto faktura)
    {
        var podmiot = _context.Podmioty.FirstOrDefault(x => x.IdPodmiotu == faktura.IdPodmiotu);
        var podmiotLabel = podmiot is null ? string.Empty : $" / {podmiot.Nazwa}";
        return $"{faktura.NumerFaktury}{podmiotLabel} (pozostało {faktura.KwotaPozostala})";
    }

    private string GetFakturaInfo(long idFaktury)
    {
        var faktura = _context.Faktury.FirstOrDefault(x => x.IdFaktury == idFaktury);
        if (faktura is null)
        {
            return "Wybierz fakturę do rozliczenia.";
        }

        return $"Pozostało do rozliczenia: {faktura.KwotaPozostala} {faktura.KodWaluty}";
    }

    private static string GetPodmiotLabel(PodmiotDto podmiot)
    {
        var nip = string.IsNullOrWhiteSpace(podmiot.NIP) ? string.Empty : $" (NIP {podmiot.NIP})";
        return $"{podmiot.Nazwa}{nip}";
    }
}