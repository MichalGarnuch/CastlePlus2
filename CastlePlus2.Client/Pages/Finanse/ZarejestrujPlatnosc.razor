@page "/finanse/platnosci/zarejestruj"
@attribute [Authorize(Roles = RoleCodes.AdminOrEmployee)]

@using System.Linq
@using MudBlazor
@using CastlePlus2.Client.Services.Finanse
@using CastlePlus2.Contracts.DTOs.Finanse
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Contracts.Requests.Finanse
@using CastlePlus2.Client.Pages.Podmioty
@using CastlePlus2.Client.Pages.Finanse
@inject IProcesyFinanseService ProcesyFinanseService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="fw-700 mb-4">Rejestracja płatności</MudText>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField Label="Podmiot"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Podmiot jest wymagany"
                                  Margin="Margin.Dense"
                                  Value="@_podmiotLabel" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="OpenPodmiotLookupDialog">
                        Wybierz podmiot
                    </MudButton>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data płatności"
                                   Required="true"
                                   RequiredError="Data płatności jest wymagana"
                                   @bind-Date="_dataPlatnosci" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Waluta"
                               Required="true"
                               RequiredError="Waluta jest wymagana"
                               @bind-Value="_model.KodWaluty"
                               Margin="Margin.Dense">
                        @foreach (var waluta in _context.Waluty)
                        {
                            <MudSelectItem T="string" Value="@waluta.KodWaluty">@($"{waluta.KodWaluty} / {waluta.Nazwa}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     RequiredError="Kwota płatności jest wymagana"
                                     @bind-Value="_model.Kwota" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Rozliczenia płatności</MudText>

            @for (var i = 0; i < _model.Rozliczenia.Count; i++)
            {
                var rozliczenie = _model.Rozliczenia[i];
                <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid rgba(255,255,255,0.08);">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2">Rozliczenie #@(i + 1)</MudText>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Disabled="@(_model.Rozliczenia.Count == 1)"
                                   OnClick="@(() => RemoveRozliczenie(rozliczenie))">
                            Usuń rozliczenie
                        </MudButton>
                    </MudStack>

                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" sm="8">
                            <MudTextField Label="Faktura"
                                          ReadOnly="true"
                                          Required="true"
                                          RequiredError="Faktura jest wymagana"
                                          Margin="Margin.Dense"
                                          Value="@GetRozliczenieLabel(rozliczenie)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="@(() => OpenFakturaLookupDialog(rozliczenie))" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFakturaInfo(rozliczenie)</MudText>
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal"
                                             Label="Kwota rozliczenia"
                                             Required="true"
                                             RequiredError="Kwota rozliczenia jest wymagana"
                                             @bind-Value="rozliczenie.Kwota" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="AddRozliczenie">
                Dodaj rozliczenie
            </MudButton>
        </MudForm>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Suma rozliczeń: @_model.Rozliczenia.Sum(x => x.Kwota)</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SubmitAsync"
                   Disabled="@(!_isFormValid || _saving)">
            Zarejestruj płatność
        </MudButton>
    }
</MudPaper>

@code {
    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private bool _isFormValid;
    private DateTime? _dataPlatnosci;
    private PlatnoscContextDto _context = new();
    private ZarejestrujPlatnoscRequest _model = new();
    private string _podmiotLabel = string.Empty;
    private readonly Dictionary<ZarejestrujPlatnoscRozliczenieRequest, string> _rozliczenieLabels = new();
    private readonly Dictionary<ZarejestrujPlatnoscRozliczenieRequest, string> _rozliczenieInfos = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _context = await ProcesyFinanseService.GetPlatnoscContextAsync();
            ResetModel();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać danych kontekstu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetModel()
    {
        _model = new ZarejestrujPlatnoscRequest
        {
            DataPlatnosci = DateTime.Today,
            Rozliczenia = new List<ZarejestrujPlatnoscRozliczenieRequest>
            {
                CreateRozliczenie()
            }
        };

        _dataPlatnosci = _model.DataPlatnosci;
        _podmiotLabel = string.Empty;
        _rozliczenieLabels.Clear();
        _rozliczenieInfos.Clear();
        foreach (var rozliczenie in _model.Rozliczenia)
        {
            _rozliczenieLabels[rozliczenie] = string.Empty;
            _rozliczenieInfos[rozliczenie] = "Wybierz fakturę do rozliczenia.";
        }
    }

    private static ZarejestrujPlatnoscRozliczenieRequest CreateRozliczenie()
        => new();

    private void AddRozliczenie()
    {
        var rozliczenie = CreateRozliczenie();
        _model.Rozliczenia.Add(rozliczenie);
        _rozliczenieLabels[rozliczenie] = string.Empty;
        _rozliczenieInfos[rozliczenie] = "Wybierz fakturę do rozliczenia.";
    }

    private void RemoveRozliczenie(ZarejestrujPlatnoscRozliczenieRequest rozliczenie)
    {
        if (_model.Rozliczenia.Count <= 1)
        {
            return;
        }

        _model.Rozliczenia.Remove(rozliczenie);
        _rozliczenieLabels.Remove(rozliczenie);
        _rozliczenieInfos.Remove(rozliczenie);
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();
        if (!_isFormValid)
        {
            return;
        }

        if (_dataPlatnosci is null)
        {
            Snackbar.Add("Data płatności jest wymagana.", Severity.Warning);
            return;
        }

        _model.DataPlatnosci = _dataPlatnosci.Value;

        _saving = true;
        try
        {
            var result = await ProcesyFinanseService.ZarejestrujPlatnoscAsync(_model);
            Snackbar.Add($"Zarejestrowano płatność (Id: {result.IdPlatnosci}).", Severity.Success);
            ResetModel();
            await _form.ResetAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się zarejestrować płatności: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetRozliczenieLabel(ZarejestrujPlatnoscRozliczenieRequest rozliczenie)
        => _rozliczenieLabels.TryGetValue(rozliczenie, out var label) ? label : string.Empty;

    private string GetFakturaInfo(ZarejestrujPlatnoscRozliczenieRequest rozliczenie)
        => _rozliczenieInfos.TryGetValue(rozliczenie, out var info) ? info : "Wybierz fakturę do rozliczenia.";

    private async Task OpenPodmiotLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<PodmiotLookupDialog>("Wybierz podmiot", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not PodmiotLookupDto selected)
            return;

        _model.IdPodmiotu = selected.IdPodmiotu;
        _podmiotLabel = selected.Label;
    }

    private async Task OpenFakturaLookupDialog(ZarejestrujPlatnoscRozliczenieRequest rozliczenie)
    {
        var parameters = new DialogParameters
        {
            ["IdPodmiotu"] = _model.IdPodmiotu > 0 ? _model.IdPodmiotu : null
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<FakturaLookupDialog>("Wybierz fakturę", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not FakturaLookupDto selected)
            return;

        rozliczenie.IdFaktury = selected.IdFaktury;
        _rozliczenieLabels[rozliczenie] = selected.Label;
        _rozliczenieInfos[rozliczenie] = $"Kwota brutto: {selected.KwotaBrutto ?? 0} (data: {selected.DataWystawienia:yyyy-MM-dd})";
    }
}