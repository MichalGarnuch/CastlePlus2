@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Finanse
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Contracts.DTOs.Slowniki
@using CastlePlus2.Client.Pages.Podmioty
@using CastlePlus2.Client.Services.Podmioty
@inject IDialogService DialogService
@inject IPodmiotyService PodmiotyService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudText Typo="Typo.h6" Class="mb-3">
                @(_isReadOnly ? "Podgląd płatności" : _isEdit ? "Edycja płatności" : "Nowa płatność")
            </MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Podmiot"
                                  Dense="true"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Podmiot jest wymagany"
                                  Value="@_podmiotLabel" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenPodmiotLookupDialog">
                            Wybierz podmiot
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudDatePicker Label="Data płatności"
                                   Dense="true"
                                   Required="true"
                                   RequiredError="Data płatności jest wymagana"
                                   Disabled="IsReadOnly"
                                   @bind-Date="_dataPlatnosci" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="string"
                               Label="Waluta (KodWaluty)"
                               Dense="true"
                               Required="true"
                               Disabled="IsReadOnly"
                               @bind-Value="_model.KodWaluty">
                        @foreach (var w in _waluty)
                        {
                            <MudSelectItem T="string" Value="@w.KodWaluty">@($"{w.KodWaluty} / {w.Nazwa}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudNumericField T="decimal"
                                     Label="Kwota"
                                     Dense="true"
                                     Required="true"
                                     RequiredError="Kwota jest wymagana"
                                     Disabled="_isReadOnly"
                                     @bind-Value="_model.Kwota" />
                </MudItem>

                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@(_isReadOnly ? "Zamknij" : "Anuluj")</MudButton>
        @if (!_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PlatnoscDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;
    [Parameter] public List<WalutaDto> Waluty { get; set; } = new();

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private PlatnoscDto _model = new();
    private List<WalutaDto> _waluty = new();

    private DateTime? _dataPlatnosci;
    private string _podmiotLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _waluty = Waluty ?? new();

        var defaultWaluta = (!IsEdit && !IsReadOnly) ? "PLN" : Model.KodWaluty;

        _model = new PlatnoscDto
        {
            IdPlatnosci = Model.IdPlatnosci,
            IdPodmiotu = Model.IdPodmiotu,
            DataPlatnosci = Model.DataPlatnosci,
            KodWaluty = defaultWaluta,
            Kwota = Model.Kwota
        };

        _dataPlatnosci = _model.DataPlatnosci == default && !IsReadOnly && !IsEdit
            ? DateTime.Today
            : _model.DataPlatnosci;

        await LoadPodmiotLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_dataPlatnosci is null)
            return;

        _model.KodWaluty = (_model.KodWaluty ?? string.Empty).Trim().ToUpperInvariant();
        _model.DataPlatnosci = _dataPlatnosci.Value.Date;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private async Task LoadPodmiotLabelAsync()
    {
        if (_model.IdPodmiotu <= 0)
        {
            _podmiotLabel = string.Empty;
            return;
        }

        var podmiot = await PodmiotyService.GetByIdAsync(_model.IdPodmiotu);
        if (podmiot is null)
        {
            _podmiotLabel = _model.IdPodmiotu.ToString();
            return;
        }

        var nip = string.IsNullOrWhiteSpace(podmiot.NIP) ? "-" : podmiot.NIP;
        _podmiotLabel = $"{podmiot.Nazwa} (NIP: {nip})";
    }

    private async Task OpenPodmiotLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<PodmiotLookupDialog>("Wybierz podmiot", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not PodmiotLookupDto selected)
            return;

        _model.IdPodmiotu = selected.IdPodmiotu;
        _podmiotLabel = selected.Label;
    }
}