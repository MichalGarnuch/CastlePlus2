@using MudBlazor
@using CastlePlus2.Contracts.DTOs.Finanse
@using CastlePlus2.Contracts.DTOs.Podmioty
@using CastlePlus2.Contracts.DTOs.Slowniki
@using CastlePlus2.Client.Pages.Podmioty
@using CastlePlus2.Client.Services.Podmioty
@inject IDialogService DialogService
@inject IPodmiotyService PodmiotyService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">

            <MudText Typo="Typo.h6" Class="mb-3">
                @(_isReadOnly ? "Podgląd faktury" : _isEdit ? "Edycja faktury" : "Nowa faktura")
            </MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.NumerFaktury"
                                  Label="Numer faktury"
                                  Dense="true"
                                  Required="true"
                                  RequiredError="Numer faktury jest wymagany"
                                  Disabled="IsReadOnly"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Podmiot"
                                  Dense="true"
                                  ReadOnly="true"
                                  Required="true"
                                  RequiredError="Podmiot jest wymagany"
                                  Value="@_podmiotLabel" />
                </MudItem>

                @if (!_isReadOnly)
                {
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OpenPodmiotLookupDialog">
                            Wybierz podmiot
                        </MudButton>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data wystawienia"
                                   Dense="true"
                                   Required="true"
                                   RequiredError="Data wystawienia jest wymagana"
                                   Disabled="IsReadOnly"
                                   @bind-Date="_dataWystawienia" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data sprzedaży (opcjonalnie)"
                                   Dense="true"
                                   Disabled="IsReadOnly"
                                   @bind-Date="_dataSprzedazy" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Waluta (KodWaluty)"
                               Dense="true"
                               Required="true"
                               Disabled="IsReadOnly"
                               @bind-Value="Model.KodWaluty">
                        @foreach (var w in Waluty)
                        {
                            <MudSelectItem T="string" Value="@w.KodWaluty">@($"{w.KodWaluty} / {w.Nazwa}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Kwota netto"
                                     Dense="true"
                                     Disabled="IsReadOnly"
                                     @bind-Value="Model.KwotaNetto" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     Label="Kwota brutto"
                                     Dense="true"
                                     Disabled="IsReadOnly"
                                     @bind-Value="Model.KwotaBrutto" />
                </MudItem>

                @if (_isEdit)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            IdFaktury: @Model.IdFaktury
                        </MudText>
                    </MudItem>
                }
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@(_isReadOnly ? "Zamknij" : "Anuluj")</MudButton>
        @if (!_isReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Zapisz</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public FakturaDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    [Parameter] public List<WalutaDto> Waluty { get; set; } = new();

    private MudForm? _form;
    private bool _isEdit => IsEdit;
    private bool _isReadOnly => IsReadOnly;

    private DateTime? _dataWystawienia;
    private DateTime? _dataSprzedazy;
    private string _podmiotLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _dataWystawienia = Model.DataWystawienia == default && !IsEdit && !IsReadOnly
            ? DateTime.Today
            : Model.DataWystawienia;
        _dataSprzedazy = Model.DataSprzedazy;

        await LoadPodmiotLabelAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_isReadOnly)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_dataWystawienia is null)
            return;

        Model.NumerFaktury = (Model.NumerFaktury ?? string.Empty).Trim();
        Model.KodWaluty = (Model.KodWaluty ?? string.Empty).Trim().ToUpperInvariant();

        Model.DataWystawienia = _dataWystawienia.Value.Date;
        Model.DataSprzedazy = _dataSprzedazy?.Date;

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private async Task LoadPodmiotLabelAsync()
    {
        if (Model.IdPodmiotu <= 0)
        {
            _podmiotLabel = string.Empty;
            return;
        }

        var podmiot = await PodmiotyService.GetByIdAsync(Model.IdPodmiotu);
        if (podmiot is null)
        {
            _podmiotLabel = Model.IdPodmiotu.ToString();
            return;
        }

        var nip = string.IsNullOrWhiteSpace(podmiot.NIP) ? "-" : podmiot.NIP;
        _podmiotLabel = $"{podmiot.Nazwa} (NIP: {nip})";
    }

    private async Task OpenPodmiotLookupDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = DialogService.Show<PodmiotLookupDialog>("Wybierz podmiot", new DialogParameters(), options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        if (result.Data is not PodmiotLookupDto selected)
            return;

        Model.IdPodmiotu = selected.IdPodmiotu;
        _podmiotLabel = selected.Label;
    }
}
