@* CastlePlus2.Client/Shared/MainLayout.razor *@
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="CastleTheme.Neon" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0" Fixed="true" Class="glass-panel castle-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />

        <MudLink Href="/" Underline="Underline.None" Class="ml-4 castle-brand">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <img src="/_content/CastlePlus2.Client/assets/brand/logo.png" alt="CastlePlus2" />
                <MudText Typo="Typo.h6" Class="fw-700" Style="letter-spacing:0.8px;">
                    CastlePlus2
                </MudText>
            </MudStack>
        </MudLink>

        <MudSpacer />

        <AuthorizeView>
            <Authorized Context="auth">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudChip T="string"
                                 Variant="Variant.Outlined"
                                 Color="Color.Inherit"
                                 Class="ml-3"
                                 Style="cursor:pointer;">
                            @GetDisplayName(auth.User)
                        </MudChip>
                    </ActivatorContent>

                    <ChildContent>
                        <MudMenuItem OnClick="@LogoutAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                            Wyloguj
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>

            <NotAuthorized>
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Class="ml-3"
                           OnClick="@(() => Nav.NavigateTo("/auth/login"))">
                    Zaloguj
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Class="glass-panel castle-drawer">

        <MudNavMenu Class="pt-8">

            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Strona główna
            </MudNavLink>

            <MudNavGroup Title="Dashboard" Expanded="@IsGroupExpanded("/dashboard")">
                <MudNavLink Href="/dashboard/najem"
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.Dashboard">
                    Dashboard
                </MudNavLink>

                <MudNavLink Href="/dashboard/v1"
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.DashboardCustomize">
                    Dashboard V1 (najem)
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Obiekty (Rdzeń)" Expanded="@IsGroupExpanded("/rdzen")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/rdzen/nieruchomosci" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.HomeWork">Nieruchomości</MudNavLink>
                <MudNavLink Href="/rdzen/budynki" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Apartment">Budynki</MudNavLink>
                <MudNavLink Href="/rdzen/lokale" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.MeetingRoom">Lokale</MudNavLink>
                <MudNavLink Href="/rdzen/pomieszczenia" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.MeetingRoom">Pomieszczenia</MudNavLink>
                <MudNavLink Href="/rdzen/adresy" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Place">Adresy</MudNavLink>
                <MudNavLink Href="/rdzen/przypisania-adresow" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Link">Przypisania adresów</MudNavLink>
                <MudNavLink Href="/rdzen/encje" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Layers">Encje</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/rdzen/adresy/przypisz" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AddLocationAlt">Przypisz adres</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Podmioty" Expanded="@IsGroupExpanded("/podmioty")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/podmioty/podmioty" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Business">Podmioty</MudNavLink>
                <MudNavLink Href="/podmioty/wlasnosci" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assignment">Własności</MudNavLink>
                <MudNavLink Href="/podmioty/kontakty" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Contacts">Kontakty</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/podmioty/wlasnosc/ustaw" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">Ustaw udziały właścicielskie</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Najem" Expanded="@IsGroupExpanded("/najem")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/najem/przedmioty-najmu" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Description">Przedmioty najmu</MudNavLink>
                <MudNavLink Href="/najem/kaucje" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Savings">Kaucje</MudNavLink>
                <MudNavLink Href="/najem/skladniki-czynszu" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.RequestQuote">Składniki czynszu</MudNavLink>
                <MudNavLink Href="/najem/umowy" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assignment">Umowy najmu</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/najem/umowy/zawrz" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditNote">Zawarcie umowy najmu</MudNavLink>
                @* Te procesy mają warianty routów z ID -> Prefix, żeby link był aktywny także na podstronach *@
                <MudNavLink Href="/najem/umowy/czynsz/aneks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RequestQuote">Aneks czynszu</MudNavLink>
                <MudNavLink Href="/najem/umowy/zakoncz" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AssignmentTurnedIn">Zakończenie umowy najmu</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Finanse" Expanded="@IsGroupExpanded("/finanse")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/finanse/faktury" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ReceiptLong">Faktury</MudNavLink>
                <MudNavLink Href="/finanse/platnosci" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Payment">Płatności</MudNavLink>
                <MudNavLink Href="/finanse/alokacje-kosztow" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PieChart">Alokacje kosztów</MudNavLink>
                <MudNavLink Href="/finanse/kategorie-kosztow" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Category">Kategorie kosztów</MudNavLink>
                <MudNavLink Href="/finanse/pozycje-kosztow" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ReceiptLong">Pozycje kosztów</MudNavLink>
                <MudNavLink Href="/finanse/rozliczenia-platnosci" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SyncAlt">Rozliczenia płatności</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/finanse/faktury/wystaw" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.NoteAdd">Wystaw fakturę</MudNavLink>
                <MudNavLink Href="/finanse/platnosci/zarejestruj" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AddCircle">Zarejestruj płatność</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Utrzymanie" Expanded="@IsGroupExpanded("/utrzymanie")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/utrzymanie/zlecenia-pracy" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Build">Zlecenia pracy</MudNavLink>
                <MudNavLink Href="/utrzymanie/powiazania-zlecenia" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Link">Powiązania zleceń</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/utrzymanie/zgloszenia/nowe" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ReportProblem">Zgłoszenie usterki</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Media" Expanded="@IsGroupExpanded("/media")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/media/rodzaje-mediow" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.WaterDrop">Rodzaje mediów</MudNavLink>
                <MudNavLink Href="/media/przylacza" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SettingsInputComposite">Przyłącza</MudNavLink>
                <MudNavLink Href="/media/liczniki" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ElectricMeter">Liczniki</MudNavLink>
                <MudNavLink Href="/media/odczyty" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FactCheck">Odczyty</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/media/odczyty/dodaj" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AddCircle">Dodaj odczyt</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Dokumenty" Expanded="@IsGroupExpanded("/dokumenty")">
                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Ewidencja (CRUD)</MudText>
                <MudNavLink Href="/dokumenty" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Description">Dokumenty</MudNavLink>
                <MudNavLink Href="/dokumenty/powiazania" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Link">Powiązania dokumentu</MudNavLink>

                <MudText Typo="Typo.caption" Class="px-4 mt-2 text-secondary">Procesy</MudText>
                <MudNavLink Href="/dokumenty/rejestruj" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PostAdd">Rejestracja dokumentu</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Raporty" Expanded="@IsGroupExpanded("/raporty")">
                <MudNavLink Href="/raporty/eksporty" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FileDownload">
                    Eksporty
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Słowniki" Expanded="@IsGroupExpanded("/slowniki")">
                <MudNavLink Href="/slowniki/jednostki-miary" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Scale">Jednostki miary</MudNavLink>
                <MudNavLink Href="/slowniki/indeksacje" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Timeline">Indeksacje</MudNavLink>
                <MudNavLink Href="/slowniki/waluty" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AttachMoney">Waluty</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Konfiguracja / CMS" Expanded="@IsGroupExpanded("/konfiguracja", "/public", "/aktualnosci")">
                @* Ma podstrony /new i /{guid} -> Prefix *@
                <MudNavLink Href="/konfiguracja/zasoby-ui" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">Zasoby UI</MudNavLink>

                @* Jeśli istnieje panel admin aktualności *@
                <MudNavLink Href="/aktualnosci" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Newspaper">Aktualności</MudNavLink>

                @* Publiczny podgląd *@
                <MudNavLink Href="/public/aktualnosci" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Public">Aktualności (public)</MudNavLink>
            </MudNavGroup>

            <AuthorizeView Roles="Admin,ADMIN">
                <MudNavGroup Title="Administracja" Expanded="@IsGroupExpanded("/admin")">
                    <MudNavLink Href="/admin/uzytkownicy-role" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AdminPanelSettings">
                        Użytkownicy i role
                    </MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4 pb-4 castle-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 glass-card">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _currentPath = "/";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override void OnInitialized()
    {
        SetCurrentPath();
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SetCurrentPath();
        StateHasChanged();
    }

    private void SetCurrentPath()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        if (string.IsNullOrWhiteSpace(relative))
        {
            _currentPath = "/";
            return;
        }

        var path = "/" + relative;
        var separatorIndex = path.IndexOfAny(new[] { '?', '#' });
        if (separatorIndex >= 0)
        {
            path = path[..separatorIndex];
        }

        _currentPath = path;
    }

    private bool IsGroupExpanded(params string[] prefixes)
    {
        foreach (var prefix in prefixes)
        {
            if (string.Equals(_currentPath, prefix, StringComparison.OrdinalIgnoreCase))
                return true;

            if (!string.Equals(prefix, "/", StringComparison.OrdinalIgnoreCase)
                && _currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        await AuthStateProvider.MarkUserAsLoggedOutAsync();

        // forceLoad resetuje stan auth po stronie hosta
        Nav.NavigateTo("/auth/login", forceLoad: true);
    }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        // 1) standard: Identity.Name (najczęściej login)
        var name = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
            return name;

        // 2) claim z loginem (jeśli ktoś tak nazwał)
        name = user.FindFirst("login")?.Value
               ?? user.FindFirst("Login")?.Value;
        if (!string.IsNullOrWhiteSpace(name))
            return name;

        // 3) email
        name = user.FindFirst(ClaimTypes.Email)?.Value
               ?? user.FindFirst("email")?.Value;
        if (!string.IsNullOrWhiteSpace(name))
            return name;

        return "Użytkownik";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
