### [AUTH] login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "loginOrEmail": "admin",
  "password": "admin123",
  "deviceInfo": "api.http"
}

### [AUTH] register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "login": "nowy.user",
  "email": "nowy.user@local",
  "password": "haslo123",
  "deviceInfo": "api.http"
}

### [AUTH] me
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}

### [AUTH] refresh
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "deviceInfo": "api.http"
}

### [AUTH][ADMIN] users
GET {{baseUrl}}/api/auth/admin/users
Authorization: Bearer {{accessToken}}

### [AUTH][ADMIN] roles
GET {{baseUrl}}/api/auth/admin/roles
Authorization: Bearer {{accessToken}}

### [AUTH][ADMIN] set roles
PUT {{baseUrl}}/api/auth/admin/users/1/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roleCodes": [
    "Admin"
  ]
}

