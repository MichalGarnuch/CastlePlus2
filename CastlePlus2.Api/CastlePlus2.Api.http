Content-Type: application/json

{
  "kodZasobu": "HOME_NEWS_001",
  "typ": "NEWS",
  "kategoria": "HOME",
  "czyAktywny": true,
  "sort": 10,
  "wazneOdUtc": null,
  "wazneDoUtc": null
}

